#!/bin/bash
# demo — create and start a demo project in one command.
# Available on the mpd-machine VM after `mpd --setup` adds bin/machine/ to PATH.
#
# Usage: demo <flavor> <tag>
#   demo moodle v5.2.0
#   demo mutms MuTMS-5.2.0-01
set -euo pipefail
trap 'echo ""; echo "Interrupted."; exit 130' INT TERM

FLAVOR="${1:-}"
TAG="${2:-}"

if [ -z "$FLAVOR" ] || [ -z "$TAG" ]; then
    echo "Usage: demo <flavor> <tag>  (e.g. demo moodle v5.2.0)" >&2
    exit 1
fi

case "$FLAVOR" in
    moodle) REPO="https://github.com/moodle/moodle" ;;
    mutms)  REPO="https://github.com/mutms/mutms" ;;
    *)
        echo "demo: unknown flavor '$FLAVOR'" >&2
        echo "Known flavors: moodle, mutms" >&2
        exit 1
        ;;
esac

# Derive project name: flavor + all digit runs from the tag concatenated.
# v5.2.0 → 520, MuTMS-5.2.0-01 → 52001
DIGITS="$(echo "$TAG" | grep -oE '[0-9]+' | tr -d '\n')"
if [ -z "$DIGITS" ]; then
    echo "demo: cannot derive project name from '$TAG' (no digits found)" >&2
    exit 1
fi

PROJECT="${FLAVOR}${DIGITS}"
RUNTIME="php"
URL="https://${PROJECT}.mpd.test/"

echo ""

if [ -d "/srv/projects/$PROJECT" ]; then
    echo "Project '$PROJECT' already exists -- starting..."
    mpd start "$PROJECT"
else
    echo "Creating $FLAVOR $TAG demo (clones repo + builds runtime -- a few minutes)..."
    echo ""

    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=advice.detachedHead GIT_CONFIG_VALUE_0=false \
        mpd create "$PROJECT" \
        --git-repo="$REPO" \
        --git-branch="$TAG" \
        --git-depth=1

    mpd configure "$PROJECT"

    mpd start "$PROJECT"

    echo ""
    echo "Installing database..."
    ssh -q -o StrictHostKeyChecking=no -o BatchMode=yes \
        "$USER@${RUNTIME}.runtime.mpd.test" \
        "bash -l -c 'cd /srv/projects/${PROJECT} && mdl-install --agree-license --adminpass=Admin1234! --adminemail=admin@example.com'"
fi

echo ""
echo "  $FLAVOR $TAG is ready."
echo ""
echo "  URL:      $URL"
echo "  Login:    admin"
echo "  Password: Admin1234!"
echo ""
