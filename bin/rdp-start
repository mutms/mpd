#!/bin/bash
# rdp-start — open an RDP door into this VM's GNOME desktop.
#
# For reaching the desktop from a device that cannot hold an SSH tunnel or
# a WireGuard overlay — an iPad, a thin client, a borrowed machine. It is
# the one thing in mpd that is not behind ssh or wg, so it is opt-in, it
# is off after a fresh bootstrap, and `rdp-stop` closes it again.
#
# What it does, all idempotent:
#   - installs xrdp + xorgxrdp if they are missing
#   - sets a login password for this user (RDP authenticates through PAM,
#     and an mpd VM's dev user normally has no password at all)
#   - points the RDP session at GNOME on Xorg, via ~/.xsession
#   - lets the remote session talk to colord without an auth-prompt loop
#   - enables and starts xrdp, listening on tcp/3389 on every address
#
# SECURITY. The mpd VM's model is "exactly two open ports, both
# cryptographically authenticated" (docs/SECURITY.md). This adds a third
# that is authenticated by a password, so treat it like one: expose it on
# a hypervisor's host-only network, or on a private network you reach
# through a bastion or a zero-trust tunnel — never straight at the
# internet. Close it with `rdp-stop` when you are done.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../bootstrap/00-common.sh"

usage() {
    cat <<'EOF'
Usage: rdp-start

Install and start xrdp, and set the password RDP will ask for.
Close the port again with `rdp-stop`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

RDP_USER="$(id -un)"
RDP_PORT=3389

# --- 1. A desktop has to exist for a session to start into -------------
step "Desktop check"
if ! command -v gnome-session >/dev/null 2>&1; then
    die "No GNOME here. Run 'gnome-install' first, then 'rdp-start'."
fi
ok "gnome-session present"

# GNOME does not run twice for the same user. If this user already holds a
# graphical session on the console, the RDP one will fail to start its
# shell — so say so now rather than after the connection drops.
if loginctl list-sessions --no-legend 2>/dev/null \
    | awk -v u="${RDP_USER}" '$3 == u && $4 == "seat0" {found=1} END {exit !found}'; then
    warn "${RDP_USER} already has a console session — log out there, or run 'gnome-stop', before connecting"
fi

# --- 2. xrdp ------------------------------------------------------------
# xorgxrdp is only a Recommends of xrdp, and it is the half that provides
# the X server. Without it xrdp accepts the login and hands back a blank
# screen, so it is named explicitly.
step "xrdp packages"
missing=()
for pkg in xrdp xorgxrdp; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if [ ${#missing[@]} -eq 0 ]; then
    ok "xrdp and xorgxrdp already installed"
else
    apt_get update -qq
    apt_get install -y --no-install-recommends "${missing[@]}"
    ok "installed ${missing[*]}"
fi

# --- 3. The session xrdp starts ----------------------------------------
# xrdp's startwm.sh runs /etc/X11/Xsession, which prefers ~/.xsession when
# there is one. Naming GNOME there is what stops Xsession falling through
# to whatever x-session-manager happens to point at.
step "Session (~/.xsession)"
XSESSION="${HOME}/.xsession"
XSESSION_MARK="# managed by mpd rdp-start"
if [ -s "${XSESSION}" ] && ! grep -qF "${XSESSION_MARK}" "${XSESSION}"; then
    warn "${XSESSION} exists and is not ours — leaving it alone"
else
    cat > "${XSESSION}" <<EOF
#!/bin/sh
${XSESSION_MARK}
# GNOME on Xorg for xrdp sessions. Delete this file to hand the choice
# back to /etc/X11/Xsession.
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=GNOME
export GNOME_SHELL_SESSION_MODE=gnome
exec /usr/bin/gnome-session
EOF
    chmod 755 "${XSESSION}"
    ok "${XSESSION} starts GNOME on Xorg"
fi

# --- 4. colord ----------------------------------------------------------
# A GNOME session with no seat cannot satisfy colord's default polkit
# rule, so every login raises an authentication dialog that reappears the
# moment it is dismissed. Grant this one user those actions instead.
step "colord polkit rule"
POLKIT_RULE=/etc/polkit-1/rules.d/49-mpd-rdp-colord.rules
sudo tee "${POLKIT_RULE}" >/dev/null <<EOF
// Managed by mpd rdp-start. Removed by rdp-stop.
//
// A remote GNOME session has no local seat, so colord's shipped rule
// falls through to "ask an administrator" and GNOME loops on the dialog.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.color-manager.") === 0 &&
        subject.user == "${RDP_USER}") {
        return polkit.Result.YES;
    }
});
EOF
sudo chmod 644 "${POLKIT_RULE}"
ok "${POLKIT_RULE}"

# --- 5. The password RDP will ask for -----------------------------------
# PAM is the only authenticator xrdp has, so the account needs a usable
# password. mpd's dev user normally has none: SSH is pubkey-only and sudo
# is NOPASSWD, so nothing has ever asked for one.
step "Login password for ${RDP_USER}"
pw_state="$(sudo passwd -S "${RDP_USER}" | awk '{print $2}')"
set_password=1
case "${pw_state}" in
    P | PS)
        if [ -t 0 ]; then
            read -r -p "A password is already set. Change it? [y/N] " reply
            case "${reply}" in
                y | Y | yes | YES) ;;
                *) set_password=0 ;;
            esac
        else
            set_password=0
        fi
        ;;
    *)
        [ -t 0 ] || die "${RDP_USER} has no password and this is not a terminal — run rdp-start interactively."
        echo "    ${RDP_USER} has no password yet; RDP cannot authenticate without one."
        ;;
esac

if [ "${set_password}" = 1 ]; then
    sudo passwd "${RDP_USER}"
    ok "password set"
else
    ok "keeping the existing password"
fi

# --- 6. Keep SSH pubkey-only -------------------------------------------
# The account has a password now. On an mpd VM SSH is meant to be
# pubkey-only anyway, so make sure that new password cannot be used to log
# in over the network as well. Only when a key is already installed —
# otherwise this would lock the developer out of their own VM.
step "SSH password authentication"
SSHD_DROPIN=/etc/ssh/sshd_config.d/20-mpd-no-ssh-password.conf
if ! command -v sshd >/dev/null 2>&1 && [ ! -x /usr/sbin/sshd ]; then
    ok "no sshd on this VM — nothing to close off"
elif sudo sshd -T 2>/dev/null | grep -qx 'passwordauthentication no'; then
    ok "already off"
elif [ -s "${HOME}/.ssh/authorized_keys" ]; then
    sudo tee "${SSHD_DROPIN}" >/dev/null <<'EOF'
# Managed by mpd rdp-start.
#
# rdp-start gives the dev user a password so xrdp can authenticate it.
# That password must not also be an SSH credential: on an mpd VM, SSH is
# pubkey-only. Remove this file only if you know why you want it gone.
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF
    sudo chmod 644 "${SSHD_DROPIN}"
    if sudo systemctl reload ssh 2>/dev/null || sudo systemctl reload sshd 2>/dev/null; then
        ok "turned off (${SSHD_DROPIN}); your key still works"
    else
        warn "wrote ${SSHD_DROPIN} but could not reload sshd — it applies at the next restart"
    fi
else
    warn "sshd accepts passwords and you have no authorized_keys — the new password is now an SSH credential too"
    warn "install your key, then re-run rdp-start to close that off"
fi

# --- 7. Start it --------------------------------------------------------
step "xrdp service"
sudo systemctl enable --now xrdp >/dev/null 2>&1
sudo systemctl is-active --quiet xrdp || die "xrdp did not start — inspect: systemctl status xrdp; journalctl -u xrdp"
ok "xrdp running and enabled at boot"

addrs="$(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]}')"

cat <<EOF

================================================================
  RDP open on tcp/${RDP_PORT}
================================================================

Connect to any of these, as ${RDP_USER}, with the password above:

$(for a in ${addrs}; do printf '    %s:%s\n' "${a}" "${RDP_PORT}"; done)

The client will warn about the certificate: xrdp serves the snakeoil
cert Debian generates at install, which nothing trusts. The RDP session
is still encrypted; accept it once and the client remembers.

Notes:

  - Only one GNOME session per user. Do not stay logged in on the
    console while using RDP — 'gnome-stop' is the tidy way.
  - Session will not start? Look at /var/log/xrdp-sesman.log and
    ~/.xorgxrdp.10.log, in that order.
  - This port is password-authenticated, unlike everything else mpd
    opens. Reach it over a private network, a bastion or a zero-trust
    tunnel, and run 'rdp-stop' when you no longer need it.
EOF
