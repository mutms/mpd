# mpd fileaccess service.
#
# Long-running container with the data volume mounted at /srv. Two access
# paths into it:
#
#   1. `podman exec` — used by Mpd.Podman.volumeTool* for volume operations
#      (the latency-saving primary use). exec is auth-free at the podman
#      level and bypasses sshd entirely.
#
#   2. ssh / scp / sftp — for ad-hoc file access from the dev's laptop. Pubkey
#      auth only, single user, no sudo, listening only on the internal podman
#      network (no -p mapping), so the SSH endpoint is reachable only via the
#      WireGuard tunnel (mpd-desktop) or the static route into the VM
#      (mpd-machine). See docs/{desktop,machine}/SECURITY.md.
#
# Host keys persist on the host under ~/.mpd/machines/<n>/fileaccess/hostkeys/
# and are bind-mounted in, so the SSH fingerprint is stable across container
# rebuilds and the user's known_hosts doesn't churn.

FROM docker.io/library/debian:trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        bash \
        coreutils \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /run/sshd /etc/ssh/keys

COPY sshd_config /etc/ssh/sshd_config
COPY entry.sh   /usr/local/bin/entry.sh
RUN chmod +x /usr/local/bin/entry.sh

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/entry.sh"]
