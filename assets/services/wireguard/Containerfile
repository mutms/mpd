# mpd WireGuard gateway image.
#
# Pre-installs wireguard-tools + iptables + iproute2 so the runtime
# container starts in seconds and never depends on mpd-internal DNS to
# resolve apt repos. apt happens during `podman build`, which uses
# --network=host (see Mpd.Podman.buildImage) — fully decoupled from
# the mpd-internal network and from dnsmasq's bring-up order.

FROM docker.io/library/debian:trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wireguard-tools \
        iptables \
        iproute2 && \
    rm -rf /var/lib/apt/lists/*
