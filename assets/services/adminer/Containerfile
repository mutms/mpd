# mpd adminer service — Debian-based.
#
# Built here instead of docker.io/library/adminer: that image is
# user-contributed and ships Alpine/musl, whose libpq fails to resolve
# multi-label hostnames like `postgres-latest.db.<zone>`. glibc works.
#
# Adminer is a single PHP file; bump ADMINER_VERSION to refresh.

FROM docker.io/library/debian:trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        php-cli \
        php-pgsql \
        php-mysql \
        php-sqlite3 \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

ARG ADMINER_VERSION=5.4.2
RUN mkdir -p /var/www/html && \
    curl -fsSL "https://github.com/vrana/adminer/releases/download/v${ADMINER_VERSION}/adminer-${ADMINER_VERSION}.php" \
        -o /var/www/html/index.php

EXPOSE 8080
WORKDIR /var/www/html
CMD ["php", "-S", "[::]:8080", "-t", "/var/www/html"]
