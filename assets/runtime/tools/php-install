#!/bin/bash
set -euo pipefail
# Tool: install one PHP version into the runtime on demand.
#
#   php-install 7.4      # add a legacy version Moodle asks for
#
# The current PHP versions are baked into the runtime image. Older, EOL
# versions (7.4, 8.0, …) are not — they arrive here only when a project
# actually needs one. `mpd configure` and `mpd start` call this for you
# when a project's MPD_PHP_VERSION is not present yet, so you rarely run
# it by hand.
#
# Runs as the dev user inside the runtime, sudo for the privileged ops
# (AGENTS.md §"Mandatory privilege rule"). Idempotent: a version already
# installed exits 0 without touching apt.
#
# Installs the same extension set, php.ini defaults and FPM wiring as a
# baked version, so a Moodle project runs the same either way.

VER="${1:-}"
if [ -z "$VER" ]; then
    echo "Usage: php-install <version>   (e.g. php-install 7.4)" >&2
    exit 2
fi
# Strict format guard: the value reaches apt as php<VER>-*, so it must be
# exactly <major>.<minor> and nothing else.
if ! [[ "$VER" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo "Bad PHP version '${VER}' — expected <major>.<minor>, e.g. 7.4 or 8.0." >&2
    exit 2
fi

# Already installed → nothing to do. (The default pool socket and FPM
# service were set up when it was first installed.)
if [ -x "/usr/bin/php${VER}" ]; then
    exit 0
fi

# The Sury PHP repository carries every version. build.sh adds it when the
# runtime is built, so it is normally already here; add it defensively for
# a runtime built before this tool existed.
SURY_LIST="/etc/apt/sources.list.d/sury-php.list"
if [ ! -f "$SURY_LIST" ]; then
    echo "Adding the Sury PHP repository..."
    sudo apt-get install -y --no-install-recommends apt-transport-https ca-certificates curl gnupg2 lsb-release
    curl -fsSL https://packages.sury.org/php/apt.gpg \
        | sudo gpg --dearmor -o /usr/share/keyrings/sury-php.gpg
    echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
        | sudo tee "$SURY_LIST" >/dev/null
    sudo apt-get update -qq
fi

# shellcheck source=/dev/null
. /opt/mpd/assets/runtime/lib/php-configure.sh

PKG_LIST=$(mpd_php_package_list "$VER")
if ! printf '%s' "$PKG_LIST" | grep -q "php${VER}-cli"; then
    echo "PHP ${VER} is not available in the apt index (php${VER}-cli missing)." >&2
    echo "Check the version, or run: sudo apt-get update" >&2
    exit 1
fi

echo "Installing PHP ${VER} (${PKG_LIST})..."
export DEBIAN_FRONTEND=noninteractive
# shellcheck disable=SC2086
sudo apt-get install -y --no-install-recommends $PKG_LIST

mpd_php_configure_version "$VER"

echo "PHP ${VER} installed."
