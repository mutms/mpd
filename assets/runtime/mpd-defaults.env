# mpd-defaults.env — runtime-wide defaults for the PHP runtime.
#
# Sourced first by source-mpd-env.sh, before any project-type defaults,
# your own mpd-virt.env, or per-project mpd.env. Last assignment wins,
# so any of those overrides values set here.
#
# Applies to every PHP project type (currently: moodle).
#
# This file is the answer to "what's the default value for MPD_PHP_*?":
# read it here. Override for all your VMs in /var/lib/mpd/env/mpd-virt.env,
# or per-project in /srv/projects/<n>/mpd.env.

# PHP version. Available: 8.1, 8.2, 8.3, 8.4, 8.5.
# Hot-switchable — running `mpd configure <project>` after editing applies it.
MPD_PHP_VERSION=8.3
