# mpd-defaults.env — the default value of every runtime-wide setting.
#
# Read this file to answer "what happens if I set nothing?". It applies to
# every PHP project type, which today means Moodle.
#
# Do not edit it. It ships with mpd and an update overwrites it. To change
# a value, set it in one of the two files that are yours:
#
#   /var/lib/mpd/env/mpd-virt.env    for all your projects, on every VM
#   /srv/projects/<name>/mpd.env     for one project
#
# mpd reads this file first, then the project type's own mpd-defaults.env,
# then your two. The last file to set a value wins, so anything above can
# be overridden below. Full model: docs/architecture.md, section 8.


# PHP version
#
# One of: 8.1, 8.2, 8.3, 8.4, 8.5.
# You can change it at any time. `mpd start <project>` switches a
# running project over.
MPD_PHP_VERSION=8.3
