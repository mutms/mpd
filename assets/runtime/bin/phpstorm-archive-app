#!/bin/bash
# phpstorm-archive-app — pack this runtime's Toolbox-installed PhpStorm
# into a single tarball at ~/install/phpstorm.tgz.
#
# The point is provisioning speed. Letting JetBrains Toolbox (or Gateway)
# download the PhpStorm backend costs minutes and three gigabytes every
# time a runtime is created — and `mpd --runtime-rebuild` creates one, so
# this is not a once-per-VM cost. A tarball costs an unpack.
#
# Once you have it, put the file in your own
#
#     ~/.mpd-virt/assets/runtime/home/default/install/phpstorm.tgz
#
# and every runtime gets it seeded into ~/install/, where
# `phpstorm-install-app` finds and unpacks it.
#
# Re-runs replace the archive: the newest install in this runtime wins.
set -euo pipefail

APPS_DIR="$HOME/.local/share/JetBrains/Toolbox/apps"
APP_NAME="phpstorm"
SRC="${APPS_DIR}/${APP_NAME}"
DEST_DIR="$HOME/install"
DEST="${DEST_DIR}/${APP_NAME}.tgz"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: phpstorm-archive-app

Pack ~/.local/share/JetBrains/Toolbox/apps/phpstorm into
~/install/phpstorm.tgz. Unpack it in another runtime with
`phpstorm-install-app`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

[ -d "${SRC}" ] || die "No PhpStorm backend at ${SRC} — connect once with PhpStorm Gateway, or install it with the Toolbox CLI, first."
[ -x "${SRC}/bin/remote-dev-server.sh" ] || die "${SRC} has no bin/remote-dev-server.sh — the install looks incomplete."

BUILD="unknown build"
if [ -f "${SRC}/build.txt" ]; then
    BUILD="$(cat "${SRC}/build.txt")"
fi

mkdir -p "${DEST_DIR}"

# Write to a temporary file in the same directory and rename over the
# destination, so an interrupted run never leaves a half-written archive
# that `phpstorm-install-app` would happily unpack.
TMP="$(mktemp "${DEST}.XXXXXX")"
trap 'rm -f "${TMP}"' EXIT

echo "Archiving ${SRC} (${BUILD})"
echo "This takes a few minutes — gzip over about three gigabytes."

# -C the apps dir so the archive holds a single top-level `phpstorm/`.
# The IDE backend may be running and touching files under it; that is a
# warning, not a failure, so exclude only the reason tar would exit 1.
tar --warning=no-file-changed -czf "${TMP}" -C "${APPS_DIR}" "${APP_NAME}"

mv -f "${TMP}" "${DEST}"
trap - EXIT
chmod 644 "${DEST}"

echo
echo "Wrote ${DEST} ($(du -h "${DEST}" | cut -f1), ${BUILD})"

# From the workstation the bare mpd-<NNN> alias reaches this runtime; the
# hostname here is that name plus -runtime.
RUNTIME_HOST="$(hostname)"
# SC2088: the tilde is meant to stay literal — this string is printed for
# the developer to run on their workstation, not expanded here.
# shellcheck disable=SC2088
OVERLAY="~/.mpd-virt/assets/runtime/home/default/install"
cat <<EOF

To seed it into every future runtime, run this on your workstation:

    mkdir -p ${OVERLAY}
    scp ${RUNTIME_HOST%-runtime}:${DEST/#"${HOME}"/\~} ${OVERLAY}/

mpd-virt pushes that overlay on adopt and update; a runtime picks it up
when it is created, and then:

    phpstorm-install-app
EOF
