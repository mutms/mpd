#!/bin/bash
# phpstorm-install-app — unpack ~/install/phpstorm.tgz into the JetBrains
# Toolbox apps directory, so a runtime gets its PhpStorm backend without
# downloading it.
#
# The archive is made by `phpstorm-archive-app` in a runtime that already
# has PhpStorm, and reaches new runtimes through your own mpd-virt overlay
# (~/.mpd-virt/assets/runtime/home/default/install/phpstorm.tgz), which
# mpd seeds into ~/install/ when the runtime is created. Worth having:
# the container's home is fresh after every `mpd --runtime-rebuild`, so
# the download is otherwise paid again each time.
#
# Idempotent, and safe to call blindly during provisioning:
#   - PhpStorm already installed -> no-op.
#   - no archive to unpack       -> says so and exits 0.
set -euo pipefail

APPS_DIR="$HOME/.local/share/JetBrains/Toolbox/apps"
APP_NAME="phpstorm"
TARGET="${APPS_DIR}/${APP_NAME}"
ARCHIVE="$HOME/install/${APP_NAME}.tgz"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: phpstorm-install-app

Unpack ~/install/phpstorm.tgz into ~/.local/share/JetBrains/Toolbox/apps/.
No-op if PhpStorm is already installed or the archive is not there.
Make the archive with `phpstorm-archive-app`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

if [ -x "${TARGET}/bin/remote-dev-server.sh" ]; then
    echo "PhpStorm already installed at ${TARGET}"
    exit 0
fi

if [ ! -f "${ARCHIVE}" ]; then
    cat <<EOF
No ${ARCHIVE} — nothing to unpack.

Make one in a runtime that has PhpStorm:

    phpstorm-archive-app

then copy it on your workstation to
~/.mpd-virt/assets/runtime/home/default/install/phpstorm.tgz so mpd-virt
seeds it into every runtime.
EOF
    exit 0
fi

# A leftover directory without the backend launcher is a failed earlier
# unpack, not an install. Clear it so tar starts from clean ground.
if [ -e "${TARGET}" ]; then
    echo "Removing incomplete ${TARGET}"
    rm -rf "${TARGET}"
fi

mkdir -p "${APPS_DIR}"

echo "Unpacking ${ARCHIVE}"
STAGE="$(mktemp -d "${APPS_DIR}/.${APP_NAME}.XXXXXX")"
trap 'rm -rf "${STAGE}"' EXIT

# Unpack beside the target and move into place, so an interrupted run
# leaves no half-extracted backend for the next run to mistake for one.
tar -xzf "${ARCHIVE}" -C "${STAGE}"
[ -x "${STAGE}/${APP_NAME}/bin/remote-dev-server.sh" ] || die "${ARCHIVE} has no ${APP_NAME}/bin/remote-dev-server.sh — re-make it with phpstorm-archive-app."

mv "${STAGE}/${APP_NAME}" "${TARGET}"
rm -rf "${STAGE}"
trap - EXIT

BUILD="unknown build"
if [ -f "${TARGET}/build.txt" ]; then
    BUILD="$(cat "${TARGET}/build.txt")"
fi

echo
echo "PhpStorm installed at ${TARGET} (${BUILD})"
cat <<EOF

Point JetBrains Toolbox or Gateway at that path to use it as an existing
installation instead of downloading the backend again. The backend
launcher itself is:

    ${TARGET}/bin/remote-dev-server.sh
EOF
