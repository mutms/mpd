# mpd.env — settings for this mdl-demo project.
#
# An mdl-demo project is the source tree of the mdl-demo tool itself. mpd
# only tracks it so it shows up in `mpd ls`; it does not build or run the
# demo container. You do that by hand — see the message `mpd start` prints.
#
# Every setting is optional. Leave a line out and mpd uses a default.
#
# mpd wrote this file when you ran `mpd init` and will never overwrite it.
# Git ignores it.


# Database
#
# This project uses none, so this is empty.
#
# Keep it empty. An empty setting here overrides any MPD_DB you set for all
# your projects in /var/lib/mpd/env/mpd-virt.env.
MPD_DB=""
