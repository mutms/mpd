#!/bin/bash
# Tool: run npx @astrojs/upgrade, rebuild, restart for current project.
# Cwd-walks to the current project. Runs as the dev user; targeted
# sudo for systemctl only (per ARCHITECTURE.md §7).
set -euo pipefail

# shellcheck source=/dev/null
source /opt/mpd/assets/runtime-base/lib/nvm-env.sh
# shellcheck source=/dev/null
source /opt/mpd/assets/runtime/project_types/astro/scripts/mpd-env.sh

cd "${PROJECT_DIR}"

if [ -f .nvmrc ]; then
    nvm install
fi

echo "Running npx @astrojs/upgrade..."
npx @astrojs/upgrade

echo "Running npm run build..."
npm run build

sudo systemctl restart "${SERVICE_NAME}"
echo "Upgrade complete — ${SERVICE_NAME} restarted."
