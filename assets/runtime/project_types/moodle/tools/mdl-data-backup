#!/bin/bash
# mdl-data-backup — save this Moodle project's data as one file.
#
# Run it from the project directory, inside the runtime:
#
#   cd /srv/projects/<project>
#   mdl-data-backup            # names the bundle after the date and time
#   mdl-data-backup before-upgrade
#
# The bundle goes to /srv/backups/projects/<project>/<name>.tgz and holds
# the database, the dataroot, this project's mpd.env, and a manifest
# saying what it came from. Copy one off the VM with scp from your Mac:
#
#   scp mpd-<NNN>-vm:/srv/backups/projects/<project>/<name>.tgz .
#
# It does not save the source tree — that is what git is for — and it
# does not save the PHPUnit or Behat dataroots, which `phpunit-init` and
# `behat-init` build again and which are large.
#
# The site stays up while this runs. Moodle's CLI maintenance mode blocks
# the web interface for as long as the backup takes, so nobody writes
# through a browser mid-dump. This is a development snapshot, not a
# production backup: it does not stop the project, and a `mdl-cron` you
# start yourself while it runs can still write.
#
# Restore one with mdl-data-restore.
set -euo pipefail

source /opt/mpd/assets/runtime/project_types/moodle/scripts/mpd-env.sh

BUNDLE_NAME="${1:-$(date -u +%Y%m%d-%H%M%SZ)}"
case "$BUNDLE_NAME" in
    -*|*/*) echo "Bad bundle name: '$BUNDLE_NAME' (no slashes, no leading dash)" >&2; exit 2 ;;
esac

if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured — nothing to back up." >&2
    echo "Run \`mpd configure\` first." >&2
    exit 1
fi

DB_ENGINE=$(moodle_status_field '.database.engine')
DB_TAG=$(moodle_status_field '.settings.dbTag')
DBHOST=$(moodle_status_field '.database.host')
PHP_VERSION=$(moodle_status_field '.settings.phpVersion')
if [ -z "$DB_ENGINE" ] || [ -z "$DBHOST" ]; then
    echo "No database recorded for '${PROJECT}' — nothing to back up." >&2
    exit 1
fi

DATA_DIR=$(moodle_status_field '.dataDir')
DATAROOT="${DATA_DIR}/dataroot"
if [ ! -d "$DATAROOT" ]; then
    echo "No dataroot at ${DATAROOT} — nothing to back up." >&2
    exit 1
fi

OUT_DIR="/srv/backups/projects/${PROJECT}"
OUT_FILE="${OUT_DIR}/${BUNDLE_NAME}.tgz"
if [ -e "$OUT_FILE" ]; then
    echo "Backup '${BUNDLE_NAME}' already exists at ${OUT_FILE}." >&2
    echo "Pick another name, or delete that file first." >&2
    exit 1
fi
mkdir -p "$OUT_DIR"

# Moodle's CLI maintenance mode is a file in the dataroot, which
# lib/setup.php checks long before it opens a database connection: a web
# request gets a 503 and nothing else happens. Written here rather than
# through `admin/cli/maintenance.php` so the same code works in
# mdl-data-restore, where the database is mid-reload and Moodle cannot
# start at all.
#
# A file that was already there is somebody's deliberate maintenance
# mode. Leave it, and leave it behind afterwards.
MAINT_FILE="${DATAROOT}/climaintenance.html"
MAINT_WAS_ON=0
[ -f "$MAINT_FILE" ] && MAINT_WAS_ON=1

STAGING="$(mktemp -d)"
cleanup() {
    rm -rf "$STAGING"
    if [ "$MAINT_WAS_ON" -eq 0 ]; then
        rm -f "$MAINT_FILE"
    fi
}
trap cleanup EXIT

if [ "$MAINT_WAS_ON" -eq 0 ]; then
    cat >"$MAINT_FILE" <<'HTML'
<!doctype html>
<title>Backup in progress</title>
<p>This site is being backed up and will be back in a moment.</p>
HTML
fi

echo "Backing up '${PROJECT}' to ${OUT_FILE}"

# --- Database ---
echo "  database (${DB_TAG:-$DB_ENGINE})"
case "$DB_ENGINE" in
    postgres)
        # As the project role, which owns the database and everything in
        # it. Ownership and grants are not carried: the restore runs as
        # the same single role, and mpd owns who that role is.
        PGPASSWORD="${PROJECT}" pg_dump -h "$DBHOST" -U "${PROJECT}" -d "${PROJECT}" \
            --no-owner --no-privileges | gzip -c >"${STAGING}/db.sql.gz"
        ;;
    mariadb|mysql)
        client="mariadb-dump"
        [ "$DB_ENGINE" = "mysql" ] && client="mysqldump"
        "$client" -h "$DBHOST" -u root -proot \
            --single-transaction --routines --events --no-tablespaces \
            "${PROJECT}" | gzip -c >"${STAGING}/db.sql.gz"
        ;;
    *)
        echo "Unknown database engine '${DB_ENGINE}' — cannot back up." >&2
        exit 1
        ;;
esac

# --- What this came from, so the restore can refuse a bundle that does
#     not fit and say why. ---
MOODLE_RELEASE=""
if [ -f "${PROJECT_DIR}/version.php" ]; then
    MOODLE_RELEASE=$(grep -oP "^\\\$release\s*=\s*'\K[^']+" "${PROJECT_DIR}/version.php" || true)
fi
jq -n \
    --arg project "$PROJECT" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg engine "$DB_ENGINE" \
    --arg dbTag "$DB_TAG" \
    --arg php "$PHP_VERSION" \
    --arg release "$MOODLE_RELEASE" \
    '{project:$project, created:$created, dbEngine:$engine, dbTag:$dbTag,
      phpVersion:$php, moodleRelease:$release}' >"${STAGING}/manifest.json"

cp "${PROJECT_DIR}/mpd.env" "${STAGING}/mpd.env"

# --- One bundle. The dataroot is added straight from where it lives
#     rather than copied into the staging directory first — it is the
#     large part, and copying it would double the disk cost.
#
#     climaintenance.html is excluded because this tool is what put it
#     there: a bundle carrying it would restore a site that is down.
#     The caches, sessions and trash are excluded because Moodle builds
#     them again on demand, and they are most of the size. ---
echo "  dataroot"
tar -czf "$OUT_FILE" \
    --exclude=dataroot/climaintenance.html \
    --exclude=dataroot/cache \
    --exclude=dataroot/localcache \
    --exclude=dataroot/temp \
    --exclude=dataroot/sessions \
    --exclude=dataroot/trashdir \
    -C "$STAGING" manifest.json db.sql.gz mpd.env \
    -C "$DATA_DIR" dataroot

echo
echo "Saved $(du -h "$OUT_FILE" | cut -f1) to ${OUT_FILE}"
echo "Restore it with: mdl-data-restore ${BUNDLE_NAME}"
