#!/bin/bash
# install — quick Moodle CLI install.
# Reads defaults from mpd.env (global and per-project).
# All arguments are passed through to admin/cli/install_database.php.
set -euo pipefail

source /opt/mpd/assets/runtime/project_types/moodle/scripts/mpd-env.sh

# Composer install runs at PROJECT_DIR — composer.json + vendor/ stay at the
# project root in both pre-5.0 and post-5.0 layouts.
if [ ! -f "${PROJECT_DIR}/vendor/autoload.php" ]; then
    echo "Running composer install..."
    (cd "${PROJECT_DIR}" && composer install --no-interaction)
fi

# Build extra options from env variables.
EXTRA_OPTS=()
[ -n "${MPD_MOODLE_AGREE_LICENSE:-}" ] && EXTRA_OPTS+=("--agree-license")
[ -n "${MPD_MOODLE_ADMINPASS:-}"     ] && EXTRA_OPTS+=("--adminpass=${MPD_MOODLE_ADMINPASS}")
[ -n "${MPD_MOODLE_ADMINEMAIL:-}"    ] && EXTRA_OPTS+=("--adminemail=${MPD_MOODLE_ADMINEMAIL}")

# moodle_run resolves admin/cli/install_database.php to the right cwd
# (root for pre-5.0 and 5.x; admin/cli/* never moved under public/).
moodle_run admin/cli/install_database.php \
    --fullname="mpd ${PROJECT}" \
    --shortname="${PROJECT}" \
    --summary="mpd dev site" \
    --adminemail="${MPD_MOODLE_ADMINEMAIL:-admin@example.com}" \
    "${EXTRA_OPTS[@]}" \
    "$@"
