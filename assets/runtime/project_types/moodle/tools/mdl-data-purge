#!/bin/bash
# Tool: revert a Moodle project to pre-configured state.
#   - Drops the project's database (per effective.json)
#   - Wipes dataroots (dataroot, dataroot_phpunit, dataroot_behat) and the
#     behat faildump dir
#   - Removes generated config files (config-mpd.php, config.php)
#   - Clears /srv/meta/<project>/{effective,urls}.json
#
# Preserves:
#   - mpd.env (user may edit DB / PHP / Behat options before re-configure)
#   - Source tree
#   - /srv/meta/<project>/{cert.pem,key.pem,project.json} (mpd-owned)
#   - /etc/php/.../pool.d/mpd-<project>.conf (project-setup.sh rewrites
#     it on next `mpd start <project>`)
#
# Permissive: warns on individual failures, never errors out. Use
# `mpd configure <project>` afterwards to validate and re-provision —
# configure is the strict script. See ARCHITECTURE.md §7.
#
# Confirmation: type the project name when prompted. Pass --yes to skip
# (scripted use).
set -uo pipefail
# Note: NOT `set -e` — purge tolerates partial failures by design.

source /opt/mpd/assets/runtime/project_types/moodle/scripts/mpd-env.sh

SKIP_CONFIRM=0
for arg in "$@"; do
    case "$arg" in
        --yes|-y) SKIP_CONFIRM=1 ;;
        *) echo "Unknown argument: $arg" >&2; exit 2 ;;
    esac
done

if [ "$SKIP_CONFIRM" -ne 1 ]; then
    cat <<EOF
About to purge ALL data for project '${PROJECT}':
  - Database: drop ${MPD_DB:-(no DB configured)}
  - Dataroots: /srv/data/${PROJECT}/{dataroot,dataroot_phpunit,dataroot_behat,behat_faildump}
  - Config files: ${PROJECT_DIR}/{config-mpd.php,config.php}
  - Meta state: /srv/meta/${PROJECT}/{effective,urls}.json

Preserved:
  - ${PROJECT_DIR}/mpd.env (edit before re-configure to change DB / PHP / Behat)
  - Source tree
  - TLS certs and project.json

EOF
    read -rp "Type the project name (${PROJECT}) to confirm: " CONFIRM
    if [ "$CONFIRM" != "${PROJECT}" ]; then
        echo "Aborted."
        exit 1
    fi
fi

# --- 1. Drop the database (per effective.json) ---
EFFECTIVE_FILE="/srv/meta/${PROJECT}/effective.json"
if [ -f "$EFFECTIVE_FILE" ]; then
    DB_ENGINE=$(jq -r '.dbEngine // empty' "$EFFECTIVE_FILE" 2>/dev/null || echo "")
    DATABASE_ID=$(jq -r '.databaseId // empty' "$EFFECTIVE_FILE" 2>/dev/null || echo "")
    if [ -n "$DB_ENGINE" ] && [ -n "$DATABASE_ID" ]; then
        DBHOST="${DATABASE_ID}.db.${MPD_ZONE}"
        case "$DB_ENGINE" in
            postgres)
                # Postgres rejects DROP DATABASE while sessions are connected.
                PGPASSWORD=postgres psql -h "$DBHOST" -U postgres -d postgres -tAc \
                    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${PROJECT}'" \
                    >/dev/null 2>&1 \
                    || echo "warning: failed to terminate sessions to '${PROJECT}' (continuing)"
                if PGPASSWORD=postgres psql -h "$DBHOST" -U postgres -d postgres -c \
                       "DROP DATABASE IF EXISTS \"${PROJECT}\"" >/dev/null 2>&1; then
                    echo "Dropped postgres DB '${PROJECT}'."
                else
                    echo "warning: failed to drop postgres DB '${PROJECT}' (continuing)"
                fi
                ;;
            mariadb|mysql)
                if mysql -h "$DBHOST" -u root -proot \
                       -e "DROP DATABASE IF EXISTS \`${PROJECT}\`" >/dev/null 2>&1; then
                    echo "Dropped ${DB_ENGINE} DB '${PROJECT}'."
                else
                    echo "warning: failed to drop ${DB_ENGINE} DB '${PROJECT}' (continuing)"
                fi
                ;;
            *)
                echo "warning: unknown DB engine '${DB_ENGINE}' in effective.json (skipping drop)"
                ;;
        esac
    else
        echo "No DB recorded in effective.json — skipping DB drop."
    fi
else
    echo "No effective.json — skipping DB drop (project may not be configured yet)."
fi

# --- 2. Wipe dataroots ---
for DIR in "/srv/data/${PROJECT}/dataroot" \
           "/srv/data/${PROJECT}/dataroot_phpunit" \
           "/srv/data/${PROJECT}/dataroot_behat" \
           "/srv/data/${PROJECT}/behat_faildump"; do
    if [ -d "$DIR" ]; then
        if rm -rf "$DIR" 2>/dev/null; then
            echo "Wiped $DIR"
        else
            echo "warning: failed to wipe $DIR (continuing)"
        fi
    fi
done

# --- 3. Remove generated config files ---
rm -f "${PROJECT_DIR}/config-mpd.php" 2>/dev/null \
    || echo "warning: failed to remove config-mpd.php (continuing)"
rm -f "${PROJECT_DIR}/config.php" 2>/dev/null \
    || echo "warning: failed to remove config.php (continuing)"

# --- 4. Clear meta state (configure regenerates) ---
rm -f "/srv/meta/${PROJECT}/effective.json" 2>/dev/null
rm -f "/srv/meta/${PROJECT}/urls.json" 2>/dev/null

cat <<EOF

Project '${PROJECT}' reverted to pre-configured state.

Next steps:
  1. (Optional) Edit ${PROJECT_DIR}/mpd.env — change DB engine,
     PHP version, Behat toggle, etc.
  2. From the host:  mpd ${PROJECT} configure
  3. Inside runtime: mdl-install
     (or open https://${PROJECT}.${MPD_ZONE}/ and use the install wizard)
EOF
