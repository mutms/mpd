# mpd.env — per-project configuration for a moodle project.
# Seeded from this project type's template/ at `mpd create <project>` time and
# never overwritten afterwards. The user is free to edit it directly, or via
# `mpd configure <project> KEY=VALUE` (mpd sanitises and rewrites lines in
# this file).
#
# This file holds per-project overrides only. The actual default values come
# from layered defaults files sourced by source-mpd-env.sh:
#   1. /opt/mpd/assets/runtime/mpd-defaults.env                       (runtime)
#   2. /opt/mpd/assets/runtime/project_types/moodle/mpd-defaults.env  (type)
#   3. /var/lib/mpd/env/mpd-vm.env                                             (VM-wide)
#   4. this file                                                       (per-project, wins)
#
# Last assignment wins. Explicit `KEY=""` blocks fall-through from earlier
# layers. This file — like everything else in the type's template/ — is
# auto-added to .git/info/exclude.

# Database engine + version (docker tag form). Bare engine expands to :latest.
# Engine ∈ {postgres, mariadb, mysql}. Version: 'latest' or digit-leading
# (e.g. 17, 17.2, 17-bookworm). Empty string ("") blocks any user default
# and means "no DB for this project". Project URL https://<project>.<zone>/
# only works when a DB is provisioned and config.php is generated.
MPD_DB=postgres:latest

# Override PHP version for this project (the runtime default lives in
# /opt/mpd/assets/runtime/mpd-defaults.env). Available: 8.1–8.5.
# Hot-switchable — running `mpd configure <project>` after editing applies it.
#MPD_PHP_VERSION=8.4

# Behat support. When 1: adds behat.<project>.<zone> URL, generates the cert
# SAN, and wires Behat against the seleniumv1 service (enabled on demand;
# >2 GB image on first enable).
# Default: 0 (off — uncomment to enable per-project, or set
# MPD_PHP_MOODLE_BEHAT=1 in /var/lib/mpd/env/mpd-vm.env for all your projects).
#MPD_PHP_MOODLE_BEHAT=1
