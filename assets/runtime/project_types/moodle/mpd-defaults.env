# mpd-defaults.env — Moodle project-type defaults.
#
# Sourced by source-mpd-env.sh between the runtime defaults
# (assets/runtime/mpd-defaults.env) and the VM-wide
# mpd-vm.env. Override VM-wide in /var/lib/mpd/env/mpd-vm.env or
# per-project in /srv/projects/<n>/mpd.env.

# Behat support. Off by default — the seleniumv1 service that Behat
# pulls in is a >2 GB image, slow on first enable, with little
# value if you're not actively writing/running Behat tests. Set to 1
# (VM-wide in mpd-vm.env or per-project in mpd.env) when you
# need Behat for a session.
MPD_PHP_MOODLE_BEHAT=0
