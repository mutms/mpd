# mpd-defaults.env — the default value of every Moodle-specific setting.
#
# Read this file to answer "what happens if I set nothing?" for a Moodle
# project. Settings that apply to every project type are one level up, in
# /opt/mpd/assets/runtime/mpd-defaults.env.
#
# Do not edit it. It ships with mpd and an update overwrites it. To change
# a value, set it in one of the two files that are yours:
#
#   /var/lib/mpd/env/mpd-virt.env    for all your projects, on every VM
#   /srv/projects/<name>/mpd.env     for one project
#
# mpd reads this file second, after the runtime defaults and before your
# two. The last file to set a value wins. Full model:
# docs/ARCHITECTURE.md, section 8.


# Behat
#
# 1 sets Behat up for the project, 0 leaves it alone.
#
# Off by default, because turning it on downloads the seleniumv1 image,
# which is over 2 GB. Switch it on when you are about to write or run
# Behat tests, and leave it off otherwise.
MPD_MOODLE_BEHAT=0
