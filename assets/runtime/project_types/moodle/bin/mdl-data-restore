#!/bin/bash
# mdl-data-restore <name>|--list — load an mdl-data-backup bundle into
# an empty project. Refuses a project that still holds data; empty it
# with `mpd reset` + `mpd start` first. See docs/usage.md "Backups".
set -euo pipefail

source /opt/mpd/assets/runtime/project_types/moodle/scripts/mpd-env.sh

# All projects share this directory; the manifest records the source
# project, which --list shows.
BACKUP_DIR="/srv/backups/projects"

list_bundles() {
    if ! compgen -G "${BACKUP_DIR}/*.tgz" >/dev/null; then
        echo "No backups yet. Make one with: mdl-data-backup"
        return 0
    fi
    printf '%-28s %-8s %-14s %-18s %s\n' "BUNDLE" "SIZE" "FROM" "DATABASE" "MOODLE"
    for f in "${BACKUP_DIR}"/*.tgz; do
        manifest=$(tar -xzOf "$f" manifest.json 2>/dev/null || echo '{}')
        printf '%-28s %-8s %-14s %-18s %s\n' \
            "$(basename "$f" .tgz)" \
            "$(du -h "$f" | cut -f1)" \
            "$(printf '%s' "$manifest" | jq -r '.project // "?"')" \
            "$(printf '%s' "$manifest" | jq -r '.dbTag // "?"')" \
            "$(printf '%s' "$manifest" | jq -r '.moodleRelease // "?"')"
    done
}

BUNDLE_NAME=""
for arg in "$@"; do
    case "$arg" in
        --list|-l) list_bundles; exit 0 ;;
        -*)        echo "Unknown argument: $arg" >&2; exit 2 ;;
        *)         BUNDLE_NAME="$arg" ;;
    esac
done

if [ -z "$BUNDLE_NAME" ]; then
    echo "Which backup? Run 'mdl-data-restore --list' to see them." >&2
    exit 2
fi

BUNDLE="${BACKUP_DIR}/${BUNDLE_NAME}.tgz"
if [ ! -f "$BUNDLE" ]; then
    echo "No backup named '${BUNDLE_NAME}'." >&2
    echo "Run 'mdl-data-restore --list' to see what is there." >&2
    exit 1
fi

if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured — there is no database to restore into." >&2
    echo "Run \`mpd start\` first." >&2
    exit 1
fi
DB_ENGINE=$(moodle_status_field '.database.engine')
DB_TAG=$(moodle_status_field '.settings.dbTag')
DBHOST=$(moodle_status_field '.database.host')
if [ -z "$DB_ENGINE" ] || [ -z "$DBHOST" ]; then
    echo "No database recorded for '${PROJECT}' — nothing to restore into." >&2
    exit 1
fi

MANIFEST=$(tar -xzOf "$BUNDLE" manifest.json 2>/dev/null || echo '{}')
FROM_ENGINE=$(printf '%s' "$MANIFEST" | jq -r '.dbEngine // empty')
FROM_TAG=$(printf '%s' "$MANIFEST" | jq -r '.dbTag // empty')
FROM_RELEASE=$(printf '%s' "$MANIFEST" | jq -r '.moodleRelease // empty')
FROM_CREATED=$(printf '%s' "$MANIFEST" | jq -r '.created // "unknown"')

# A dump is written in its engine's own dialect, and a half-loaded
# database is worse than none — so a mismatch is a refusal.
if [ -n "$FROM_ENGINE" ] && [ "$FROM_ENGINE" != "$DB_ENGINE" ]; then
    echo "This backup is from ${FROM_ENGINE}, and '${PROJECT}' now runs ${DB_ENGINE}." >&2
    echo "Set MPD_DB back to a ${FROM_ENGINE} version in mpd.env, run \`mpd start\`," >&2
    echo "then restore." >&2
    exit 1
fi

# The database is where "still has data" is checked: an empty database
# implies an empty dataroot, because only `mpd reset` empties either.
# It also makes a second restore refuse instead of merging dataroots.
case "$DB_ENGINE" in
    postgres|mariadb|mysql) ;;
    *) echo "Unknown database engine '${DB_ENGINE}' — cannot restore." >&2; exit 1 ;;
esac
TABLE_COUNT=$(moodle_db_table_count)

if [ "${TABLE_COUNT:-0}" -ne 0 ]; then
    TABLE_NOUN="tables"
    [ "$TABLE_COUNT" -eq 1 ] && TABLE_NOUN="table"
    cat >&2 <<EOF
'${PROJECT}' still has data — its database holds ${TABLE_COUNT} ${TABLE_NOUN}.

Restore only writes into an empty project. Empty this one first:

    mpd reset
    mpd start
    mdl-data-restore ${BUNDLE_NAME}

\`mpd reset\` is the command that destroys data. It also stops the
project and tears down what the project type built, which is why this
tool does not try to do it.
EOF
    exit 1
fi

DATA_DIR=$(moodle_status_field '.dataDir')
DATAROOT="${DATA_DIR}/dataroot"

# The CLI maintenance file 503s web requests before any DB connection,
# so the web interface stays fenced while the database reloads.
# Written directly: admin/cli/maintenance.php needs a database to run.
# A pre-existing file is somebody's deliberate maintenance mode: leave
# it, before and after.
MAINT_FILE="${DATAROOT}/climaintenance.html"
MAINT_WAS_ON=0
[ -f "$MAINT_FILE" ] && MAINT_WAS_ON=1

STAGING="$(mktemp -d)"
cleanup() {
    rm -rf "$STAGING"
    if [ "$MAINT_WAS_ON" -eq 0 ]; then
        rm -f "$MAINT_FILE"
    fi
}
trap cleanup EXIT

mkdir -p "$DATAROOT"
if [ "$MAINT_WAS_ON" -eq 0 ]; then
    cat >"$MAINT_FILE" <<'HTML'
<!doctype html>
<title>Restore in progress</title>
<p>This site is being restored and will be back in a moment.</p>
HTML
fi

echo "Restoring '${BUNDLE_NAME}' into '${PROJECT}' (taken ${FROM_CREATED})"

# Unpack before loading anything: a bundle that will not open should
# fail while the project is still untouched.
tar -xzf "$BUNDLE" -C "$STAGING" manifest.json db.sql.gz mpd.env

echo "  database (${FROM_TAG:-$FROM_ENGINE} → ${DB_TAG:-$DB_ENGINE})"
case "$DB_ENGINE" in
    postgres)
        # Load as the project role, so every table the dump creates is
        # owned by the role Moodle connects as.
        gunzip -c "${STAGING}/db.sql.gz" \
            | PGPASSWORD="${PROJECT}" psql -h "$DBHOST" -U "${PROJECT}" -d "${PROJECT}" \
                -q -v ON_ERROR_STOP=1 >/dev/null
        ;;
    mariadb|mysql)
        client="mariadb"
        [ "$DB_ENGINE" = "mysql" ] && client="mysql"
        # --skip-ssl: the client defaults SSL on, but the DB container
        # serves plaintext on the private network, so it would refuse.
        gunzip -c "${STAGING}/db.sql.gz" \
            | "$client" -h "$DBHOST" -u root -proot --skip-ssl "${PROJECT}"
        ;;
esac

echo "  dataroot"
tar -xzf "$BUNDLE" -C "$DATA_DIR" dataroot

NOW_RELEASE=""
if [ -f "${PROJECT_DIR}/version.php" ]; then
    NOW_RELEASE=$(grep -oP "^\\\$release\s*=\s*'\K[^']+" "${PROJECT_DIR}/version.php" || true)
fi

cat <<EOF

Restored '${BUNDLE_NAME}' into '${PROJECT}'.

Next:
  1. mdl-cache-purge
EOF
if [ -n "$FROM_RELEASE" ] && [ -n "$NOW_RELEASE" ] && [ "$FROM_RELEASE" != "$NOW_RELEASE" ]; then
    echo "  2. mdl-upgrade   (backup is Moodle ${FROM_RELEASE}, code here is ${NOW_RELEASE})"
fi
