#!/bin/bash
# mdl-data-backup [name] — save this project's database, dataroot and
# mpd.env as one bundle in /srv/backups/projects/. Restore with
# mdl-data-restore. See docs/usage.md "Backups".
set -euo pipefail

source /opt/mpd/assets/runtime/project_types/moodle/scripts/mpd-env.sh

BUNDLE_NAME="${1:-$(date -u +%Y%m%d-%H%M%SZ)}"
case "$BUNDLE_NAME" in
    -*|*/*) echo "Bad bundle name: '$BUNDLE_NAME' (no slashes, no leading dash)" >&2; exit 2 ;;
esac

if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured — nothing to back up." >&2
    echo "Run \`mpd start\` first." >&2
    exit 1
fi

DB_ENGINE=$(moodle_status_field '.database.engine')
DB_TAG=$(moodle_status_field '.settings.dbTag')
DBHOST=$(moodle_status_field '.database.host')
PHP_VERSION=$(moodle_status_field '.settings.phpVersion')
if [ -z "$DB_ENGINE" ] || [ -z "$DBHOST" ]; then
    echo "No database recorded for '${PROJECT}' — nothing to back up." >&2
    exit 1
fi

DATA_DIR=$(moodle_status_field '.dataDir')
DATAROOT="${DATA_DIR}/dataroot"
if [ ! -d "$DATAROOT" ]; then
    echo "No dataroot at ${DATAROOT} — nothing to back up." >&2
    exit 1
fi

OUT_DIR="/srv/backups/projects"
OUT_FILE="${OUT_DIR}/${BUNDLE_NAME}.tgz"
if [ -e "$OUT_FILE" ]; then
    echo "Backup '${BUNDLE_NAME}' already exists at ${OUT_FILE}." >&2
    echo "Pick another name, or delete that file first." >&2
    exit 1
fi
mkdir -p "$OUT_DIR"

# The CLI maintenance file 503s web requests before any DB connection.
# Written directly, not via admin/cli/maintenance.php, so the same
# code works in mdl-data-restore, where Moodle cannot start. A
# pre-existing file is somebody's deliberate maintenance mode: leave
# it, before and after.
MAINT_FILE="${DATAROOT}/climaintenance.html"
MAINT_WAS_ON=0
[ -f "$MAINT_FILE" ] && MAINT_WAS_ON=1

STAGING="$(mktemp -d)"
cleanup() {
    rm -rf "$STAGING"
    if [ "$MAINT_WAS_ON" -eq 0 ]; then
        rm -f "$MAINT_FILE"
    fi
}
trap cleanup EXIT

if [ "$MAINT_WAS_ON" -eq 0 ]; then
    cat >"$MAINT_FILE" <<'HTML'
<!doctype html>
<title>Backup in progress</title>
<p>This site is being backed up and will be back in a moment.</p>
HTML
fi

echo "Backing up '${PROJECT}' to ${OUT_FILE}"

echo "  database (${DB_TAG:-$DB_ENGINE})"
case "$DB_ENGINE" in
    postgres)
        # Dump as the project role. Ownership and grants are not
        # carried: the restore runs as the same single role.
        PGPASSWORD="${PROJECT}" pg_dump -h "$DBHOST" -U "${PROJECT}" -d "${PROJECT}" \
            --no-owner --no-privileges | gzip -c >"${STAGING}/db.sql.gz"
        ;;
    mariadb|mysql)
        client="mariadb-dump"
        [ "$DB_ENGINE" = "mysql" ] && client="mysqldump"
        # --skip-ssl: the client defaults SSL on, but the DB container
        # serves plaintext on the private network, so it would refuse.
        "$client" -h "$DBHOST" -u root -proot --skip-ssl \
            --single-transaction --routines --events --no-tablespaces \
            "${PROJECT}" | gzip -c >"${STAGING}/db.sql.gz"
        ;;
    *)
        echo "Unknown database engine '${DB_ENGINE}' — cannot back up." >&2
        exit 1
        ;;
esac

# The manifest records what this came from, so restore can refuse a
# bundle that does not fit.
MOODLE_RELEASE=""
if [ -f "${PROJECT_DIR}/version.php" ]; then
    MOODLE_RELEASE=$(grep -oP "^\\\$release\s*=\s*'\K[^']+" "${PROJECT_DIR}/version.php" || true)
fi
jq -n \
    --arg project "$PROJECT" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg engine "$DB_ENGINE" \
    --arg dbTag "$DB_TAG" \
    --arg php "$PHP_VERSION" \
    --arg release "$MOODLE_RELEASE" \
    '{project:$project, created:$created, dbEngine:$engine, dbTag:$dbTag,
      phpVersion:$php, moodleRelease:$release}' >"${STAGING}/manifest.json"

cp "${PROJECT_DIR}/mpd.env" "${STAGING}/mpd.env"

# The dataroot is added straight from where it lives; copying it into
# staging would double the disk cost. climaintenance.html is excluded
# because this tool wrote it. Caches, sessions and trash rebuild on
# demand and are most of the size.
echo "  dataroot"
tar -czf "$OUT_FILE" \
    --exclude=dataroot/climaintenance.html \
    --exclude=dataroot/cache \
    --exclude=dataroot/localcache \
    --exclude=dataroot/temp \
    --exclude=dataroot/sessions \
    --exclude=dataroot/trashdir \
    -C "$STAGING" manifest.json db.sql.gz mpd.env \
    -C "$DATA_DIR" dataroot

echo
echo "Saved $(du -h "$OUT_FILE" | cut -f1) to ${OUT_FILE}"
echo "Restore it with: mdl-data-restore ${BUNDLE_NAME}"
