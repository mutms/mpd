#!/bin/bash
# Tool: install moodle-plugin-ci into /srv/extra/mpci/.
# Idempotent; re-run after `rm` to pick up a newer release. /srv
# persists across runtime rebuilds and needs no privilege.
set -euo pipefail

TARGET="/srv/extra/mpci/moodle-plugin-ci.phar"
URL="https://github.com/moodlehq/moodle-plugin-ci/releases/latest/download/moodle-plugin-ci.phar"

if [ -f "$TARGET" ]; then
    echo "moodle-plugin-ci already installed at $TARGET — skipping."
    exit 0
fi

mkdir -p "$(dirname "$TARGET")"
echo "Downloading moodle-plugin-ci..."
curl -fsSL -o "$TARGET.tmp" "$URL"
chmod 755 "$TARGET.tmp"
mv "$TARGET.tmp" "$TARGET"

echo "moodle-plugin-ci installed at $TARGET. Use 'mpci' to run it."
