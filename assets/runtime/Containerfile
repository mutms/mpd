# mpd-runtime — the pre-baked base image of the runtime container.
# Debian Trixie plus everything bootstrap/60-install-software.sh installs,
# so creating a runtime is a pull plus configuration instead of an apt run.
# mpd pulls the tag pinned in go/internal/runtime/runtime.go (runtime.Image).
#
# To build locally, tag it with that same pinned name, e.g.:
#
#   container build -t ghcr.io/mutms/mpd-runtime:13.6.1 assets/runtime
FROM debian:13.6

ARG VERSION
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/mutms/mpd"

RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo ca-certificates curl gnupg2 lsb-release \
    && rm -rf /var/lib/apt/lists/*

COPY bootstrap/60-install-software.sh /tmp/mpd/bootstrap/
COPY lib/php-configure.sh /tmp/mpd/lib/
RUN bash /tmp/mpd/bootstrap/60-install-software.sh \
    && rm -rf /tmp/mpd /var/lib/apt/lists/* \
    && systemctl enable ssh

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
