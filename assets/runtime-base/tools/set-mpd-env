#!/bin/bash
# set-mpd-env.sh <env-file-path> <KEY> <VALUE>
# Replace or delete a single KEY=... line in an mpd.env-style file.
#
# Semantics:
#   - If <VALUE> is non-empty: delete any existing KEY= line, then append
#     "KEY=<VALUE>" to the file.
#   - If <VALUE> is empty: delete any existing KEY= line and do nothing else.
#     This makes the key "absent" so layered resolution falls through to
#     /var/lib/mpd/env/mpd-vm.env (or whatever lower layer is in effect).
#
# Safe to call even if the file does not yet exist; this script does not create
# the file (project-create.sh seeds it from the type's mpd-template.env).
#
# Caller is expected to have validated KEY against ^MPD_[A-Z0-9_]+$ and VALUE
# against a safe charset in mpd. This script does no validation.
set -euo pipefail

PATH_TO_FILE="$1"
KEY="$2"
VALUE="${3:-}"

if [ ! -f "$PATH_TO_FILE" ]; then
    echo "Error: ${PATH_TO_FILE} does not exist." >&2
    exit 1
fi

# Idempotent delete of any existing line for this key (matches start-of-line).
sed -i "/^${KEY}=/d" "$PATH_TO_FILE"

# Append only if value is non-empty.
if [ -n "$VALUE" ]; then
    echo "${KEY}=${VALUE}" >> "$PATH_TO_FILE"
fi
