# mpd Caddyfile header — emitted once at the top of the generated config.
# Per-vhost blocks below each `import deny_sensitive` to share these rules.

{
    # No public-CA HTTPS certs — mpd's CA signs everything internally.
    auto_https off

    # The apex caddy (caddy.service) holds caddy's default admin
    # endpoint, localhost:2019. Two caddies on one host would otherwise
    # share it, and a reload meant for one would load into the other —
    # leaving whichever lost with an empty config and no listeners.
    admin localhost:2020
}

(deny_sensitive) {
    # The webroot is the project checkout, so mpd.env, .git/ and friends
    # sit under it. Deny dot-segments, dependency dirs, mpd/project config
    # files, and phars. 404, not 403 — do not acknowledge the file exists.
    @denied path_regexp /\.|/(vendor|node_modules)/|/(mpd\.env|config-mpd\.php|compose\.yaml|docker-compose\.yml|phpunit\.xml|behat\.yml)$|\.phar$
    respond @denied 404
}
