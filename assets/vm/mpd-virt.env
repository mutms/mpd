# mpd-virt.env — your defaults, shared by every mpd VM you run.
#
# Lives at /var/lib/mpd/env/mpd-virt.env on the VM AND inside its runtime
# container (directory bind-mount). Edits are visible immediately inside a
# running runtime — no sync, no reload step.
#
# Layered third (after runtime + type defaults, before per-project mpd.env).
#
# Authored on the Mac at ~/.mpd-virt/mpd-virt.env, from where mpd-virt
# pushes it into every VM on takeover/start/update — that is what makes it
# shared rather than per-VM. The Mac is the source of truth: an edit made
# here survives only until the next push. On a sandbox VM (no mpd-virt,
# nothing pushing) this file is seeded from the template once and is
# yours to edit in place.
#
# Keys are namespaced MPD_<TYPE>_<KEY> (project-type-specific) or
# MPD_<KEY> (runtime-wide and mpd infra). MPD_PHP_* means the PHP
# interpreter itself, not a runtime label.

# === PHP =====================================================================

# PHP version applied to all PHP project types (currently: moodle).
# Available: 8.1, 8.2, 8.3, 8.4, 8.5. Runtime default lives in
# /opt/mpd/assets/runtime/mpd-defaults.env; uncomment here to override
# globally for your projects.
#MPD_PHP_VERSION=8.4

# === Moodle install defaults =================================================

# Automatically agree to license during mdl-install.
#MPD_MOODLE_AGREE_LICENSE=1

# Default administrator password for mdl-install.
#MPD_MOODLE_ADMINPASS=Admin.1234

# Default administrator email for mdl-install.
#MPD_MOODLE_ADMINEMAIL=admin@example.com

# === PHPUnit settings ========================================================

# Allow execution of tests that need external services (redis, memcached, solr, ldap).
#MPD_MOODLE_PHPUNIT_EXTERNAL_SERVICES=1

# === Behat settings ==========================================================

# Use headless browser in Behat tests.
#MPD_MOODLE_BEHAT_BROWSER_HEADLESS=1

# === Xdebug ==================================================================

# Enable Xdebug: off, debug, profile, coverage, trace
# Requires runtime recreation to take effect.
#MPD_XDEBUG_MODE=off

# === mpd inside runtime containers ===========================================

# Turn off the ability to run `mpd create|configure|start|stop|delete|show`
# from inside a runtime container. Left on, `mpd` works over that runtime's
# control socket, scoped to projects belonging to that runtime.
#
# The reason to turn it off is blast radius: a runtime is where AI agents run
# with passwordless sudo, and with this on such an agent can delete a project
# (its database, dataroot and source tree), not only edit files. It can
# never create or delete databases, rebuild the runtime, or run any
# --vm-* / --runtime-* / --service-* flag. See docs/SECURITY.md.
#
# Read per request: a change applies to the next command, no restart.
# Only off/false/0/no disable it.
#MPD_RUNTIME_CONTROL=off
