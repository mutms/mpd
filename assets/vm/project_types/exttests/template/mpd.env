# mpd.env — settings for the Moodle external test files.
#
# This project serves the files that Moodle's phpunit tests download,
# such as test.html and test_redir.php. A Moodle project finds it
# through MPD_MOODLE_EXTTESTS in its own mpd.env.
#
# Edit this file, then run: mpd start <project>
#
# mpd wrote this file when you ran `mpd init` and will never overwrite
# it. Git ignores it.
#
# Where defaults come from and which file wins when two disagree:
# docs/architecture.md, section 8.


# Database
#
# The test files need no database, so this is empty.
#
# Keep it empty. An empty setting here overrides any MPD_DB you set for
# all your projects, which would otherwise give this project a database
# it never uses.
MPD_DB=""


# PHP version
#
# Empty means the VM's default PHP version. The test scripts are tiny and
# run on any version.
#
#   MPD_PHP_VERSION="8.4"
