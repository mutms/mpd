# mpd-defaults.env — the default value of every Moodle-specific setting.
#
# Read this file to answer "what happens if I set nothing?" for a Moodle
# project.
#
# Do not edit it. It ships with mpd and an update overwrites it. To change a
# value, override it in a project's own /srv/projects/<name>/mpd.env (a type
# default like these wins over an ambient value from your vm.env). Full
# model: docs/architecture.md, section 8.


# Database
#
# The database a Moodle project gets when its own mpd.env sets no MPD_DB,
# written like a container tag.
#
# postgres:17 matches the mdl-demo demo image, which runs Debian Trixie's
# own PostgreSQL. Keep the two the same so a site backup moves between a
# Moodle project here and an mdl-demo demo without a database-version
# mismatch. If mdl-demo moves to a new PostgreSQL, change this line to match.
MPD_DB=postgres:17


# PHP version
#
# The PHP version a Moodle project gets when its own mpd.env sets no
# MPD_PHP_VERSION. One of: 8.1, 8.2, 8.3, 8.4, 8.5.
#
# 8.3 matches the mdl-demo demo image. Keep the two the same so code that
# runs in a Moodle project here also runs in an mdl-demo demo. If mdl-demo
# moves to a new PHP, change this line to match.
MPD_PHP_VERSION=8.3


# Behat
#
# 1 sets Behat up for the project, 0 leaves it alone.
#
# Off by default, because turning it on downloads the selenium image,
# which is over 2 GB. Switch it on when you are about to write or run
# Behat tests, and leave it off otherwise.
MPD_MOODLE_BEHAT=0
