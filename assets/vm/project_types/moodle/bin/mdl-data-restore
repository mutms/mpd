#!/bin/bash
# mdl-data-restore <name>|--list — load an mdl-data-backup (.mdb) bundle into
# an empty project. Refuses a project that still holds data; empty it with
# `mpd reset` + `mpd start` first. The .mdb format is shared with mdl-demo, so
# a bundle made there restores here too (and vice versa). See docs/usage.md
# "Backups".
set -euo pipefail

source /opt/mpd/assets/vm/project_types/moodle/scripts/mpd-env.sh

# All projects share this directory; the manifest records the source recipe,
# which --list shows.
BACKUP_DIR="/srv/backups/projects"

# db_major prints the leading integer of a "<engine>:<version>" tag, or nothing
# when there is no numeric version.
db_major() {
    local ver="${1#*:}"
    ver="${ver%%.*}"
    [[ "$ver" =~ ^[0-9]+$ ]] && printf '%s' "$ver"
}

list_bundles() {
    if ! compgen -G "${BACKUP_DIR}/*.mdb" >/dev/null; then
        echo "No backups yet. Make one with: mdl-data-backup"
        return 0
    fi
    printf '%-28s %-8s %-14s %-24s %s\n' "BUNDLE" "SIZE" "DATABASE" "RECIPE" "CREATED"
    for f in "${BACKUP_DIR}"/*.mdb; do
        meta=$(tar -xzOf "$f" meta.json 2>/dev/null || echo '{}')
        printf '%-28s %-8s %-14s %-24s %s\n' \
            "$(basename "$f" .mdb)" \
            "$(du -h "$f" | cut -f1)" \
            "$(printf '%s' "$meta" | jq -r '.db // "?"')" \
            "$(printf '%s' "$meta" | jq -r '.recipe // "?"')" \
            "$(printf '%s' "$meta" | jq -r '.created // "?"')"
    done
}

BUNDLE_NAME=""
for arg in "$@"; do
    case "$arg" in
        --list|-l) list_bundles; exit 0 ;;
        -*)        echo "Unknown argument: $arg" >&2; exit 2 ;;
        *)         BUNDLE_NAME="$arg" ;;
    esac
done

if [ -z "$BUNDLE_NAME" ]; then
    echo "Which backup? Run 'mdl-data-restore --list' to see them." >&2
    exit 2
fi

BUNDLE="${BACKUP_DIR}/${BUNDLE_NAME}.mdb"
if [ ! -f "$BUNDLE" ]; then
    echo "No backup named '${BUNDLE_NAME}'." >&2
    echo "Run 'mdl-data-restore --list' to see what is there." >&2
    exit 1
fi

if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured — there is no database to restore into." >&2
    echo "Run \`mpd start\` first." >&2
    exit 1
fi
DB_ENGINE=$(moodle_status_field '.database.engine')
DB_TAG=$(moodle_status_field '.settings.dbTag')
DBHOST=$(moodle_status_field '.database.host')
if [ -z "$DB_ENGINE" ] || [ -z "$DBHOST" ]; then
    echo "No database recorded for '${PROJECT}' — nothing to restore into." >&2
    exit 1
fi

META=$(tar -xzOf "$BUNDLE" meta.json 2>/dev/null || echo '{}')
REVISION=$(printf '%s' "$META" | jq -r '.revision // 2')
FROM_DB=$(printf '%s' "$META" | jq -r '.db // "postgres:17"')
FROM_RECIPE=$(printf '%s' "$META" | jq -r '.recipe // empty')
FROM_CREATED=$(printf '%s' "$META" | jq -r '.created // "unknown"')
FROM_ENGINE="${FROM_DB%%:*}"

# A dump is written in its engine's own dialect, and a half-loaded database is
# worse than none — so an engine mismatch is a refusal.
if [ -n "$FROM_ENGINE" ] && [ "$FROM_ENGINE" != "$DB_ENGINE" ]; then
    echo "This backup is ${FROM_DB}, and '${PROJECT}' runs ${DB_ENGINE}." >&2
    echo "Set MPD_DB back to a ${FROM_ENGINE} version in mpd.env, run \`mpd start\`," >&2
    echo "then restore." >&2
    exit 1
fi

# A plain dump loads forward into an equal-or-newer server, never backward — so
# a newer source than this project's engine version is a refusal.
FROM_MAJOR=$(db_major "$FROM_DB")
TARGET_MAJOR=$(db_major "${DB_TAG:-}")
if [ -n "$FROM_MAJOR" ] && [ -n "$TARGET_MAJOR" ] && [ "$FROM_MAJOR" -gt "$TARGET_MAJOR" ]; then
    echo "This backup is ${FROM_DB}, newer than '${PROJECT}' (${DB_TAG})." >&2
    echo "Set MPD_DB=${FROM_ENGINE}:${FROM_MAJOR} (or newer) in mpd.env, run \`mpd start\`," >&2
    echo "then restore." >&2
    exit 1
fi

case "$DB_ENGINE" in
    postgres|mariadb|mysql) ;;
    *) echo "Unknown database engine '${DB_ENGINE}' — cannot restore." >&2; exit 1 ;;
esac

# The database is where "still has data" is checked: an empty database implies
# an empty dataroot, because only `mpd reset` empties either. It also makes a
# second restore refuse instead of merging dataroots.
TABLE_COUNT=$(moodle_db_table_count)
if [ "${TABLE_COUNT:-0}" -ne 0 ]; then
    TABLE_NOUN="tables"
    [ "$TABLE_COUNT" -eq 1 ] && TABLE_NOUN="table"
    cat >&2 <<EOF
'${PROJECT}' still has data — its database holds ${TABLE_COUNT} ${TABLE_NOUN}.

Restore only writes into an empty project. Empty this one first:

    mpd reset
    mpd start
    mdl-data-restore ${BUNDLE_NAME}

\`mpd reset\` is the command that destroys data. It also stops the project and
tears down what the project type built, which is why this tool does not try to
do it.
EOF
    exit 1
fi

DATA_DIR=$(moodle_status_field '.dataDir')
DATAROOT="${DATA_DIR}/dataroot"

# The CLI maintenance file 503s web requests before any DB connection, so the
# web interface stays fenced while the database reloads. A pre-existing file is
# somebody's deliberate maintenance mode: leave it, before and after.
MAINT_FILE="${DATAROOT}/climaintenance.html"
MAINT_WAS_ON=0
[ -f "$MAINT_FILE" ] && MAINT_WAS_ON=1

STAGING="$(mktemp -d)"
cleanup() {
    rm -rf "$STAGING"
    if [ "$MAINT_WAS_ON" -eq 0 ]; then
        rm -f "$MAINT_FILE"
    fi
}
trap cleanup EXIT

mkdir -p "$DATAROOT"
if [ "$MAINT_WAS_ON" -eq 0 ]; then
    cat >"$MAINT_FILE" <<'HTML'
<!doctype html>
<title>Restore in progress</title>
<p>This site is being restored and will be back in a moment.</p>
HTML
fi

echo "Restoring '${BUNDLE_NAME}' into '${PROJECT}' (taken ${FROM_CREATED})"

# Unpack the dump before loading anything: a bundle that will not open should
# fail while the project is still untouched.
tar -xzf "$BUNDLE" -C "$STAGING" db.sql

echo "  database (${FROM_DB})"
case "$DB_ENGINE" in
    postgres)
        # Load as the project role, so every table the dump creates is owned by
        # the role Moodle connects as.
        PGPASSWORD="${PROJECT}" psql -h "$DBHOST" -U "${PROJECT}" -d "${PROJECT}" \
            -q -v ON_ERROR_STOP=1 -f "${STAGING}/db.sql" >/dev/null
        ;;
    mariadb|mysql)
        client="mariadb"
        [ "$DB_ENGINE" = "mysql" ] && client="mysql"
        # --skip-ssl: the client defaults SSL on, but the DB container serves
        # plaintext on the private network, so it would refuse.
        "$client" -h "$DBHOST" -u root -proot --skip-ssl "${PROJECT}" <"${STAGING}/db.sql"
        ;;
esac

# The dataroot member is dataroot/ from revision 2, demo/ from revision 1
# (mdl-demo's older name). Either way it lands at this project's dataroot.
echo "  dataroot"
if [ "${REVISION:-2}" -le 1 ]; then
    tar -xzf "$BUNDLE" -C "$DATA_DIR" demo
    rm -rf "$DATAROOT"
    mv "${DATA_DIR}/demo" "$DATAROOT"
else
    tar -xzf "$BUNDLE" -C "$DATA_DIR" dataroot
fi

cat <<EOF

Restored '${BUNDLE_NAME}' into '${PROJECT}'.

Next:
  1. mdl-cache-purge
  2. mdl-upgrade   (if this project's code tree differs from the backup's)
EOF
if [ -n "$FROM_RECIPE" ]; then
    echo
    echo "The backup's code recipe was: ${FROM_RECIPE}"
fi
