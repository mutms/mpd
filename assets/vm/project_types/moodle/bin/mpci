#!/bin/bash
# mpci — run moodle-plugin-ci commands.
# Install first with: mpci-install
# All arguments are passed through to moodle-plugin-ci.
set -euo pipefail

MPCI_PHAR="/srv/extra/mpci/moodle-plugin-ci.phar"

if [ ! -f "$MPCI_PHAR" ]; then
    echo "Error: moodle-plugin-ci not installed — run 'mpci-install' first" >&2
    exit 1
fi

exec php "$MPCI_PHAR" "$@"
