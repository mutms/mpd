#!/bin/bash
# behat — run Behat tests for the current project.
# All arguments are passed through to vendor/bin/behat.
#
# A project has four independent behat sites. The name this tool is
# called by picks one: behat, behat1, behat2 or behat3. Each needs its
# own init: behat-init, behat1-init, behat2-init, behat3-init.
set -euo pipefail

source /opt/mpd/assets/vm/project_types/moodle/scripts/mpd-env.sh

# Behat must be enabled at the mpd level, which publishes the behat
# vhost and TLS cert. Otherwise Moodle's reachability check fails with
# an opaque "site is not available".
if [ "${MPD_MOODLE_BEHAT:-0}" != "1" ]; then
    echo "Error: Behat is not enabled for project '${PROJECT}' in mpd." >&2
    echo "The behat.${PROJECT}.${MPD_ZONE} site is not published. Enable it from" >&2
    echo "the VM host (or over SSH to the VM), then re-run behat-init:" >&2
    echo >&2
    echo "    mpd start ${PROJECT} MPD_MOODLE_BEHAT=1" >&2
    exit 1
fi

cd "${PROJECT_DIR}"

moodle_behat_instance
INIT_TOOL="${BEHAT_HOST_LABEL}-init"
BEHAT_CONFIG="${BEHAT_DATAROOT}/behatrun/behat/behat.yml"

if [ ! -f "vendor/bin/behat" ]; then
    echo "Error: vendor/bin/behat not found — run '${INIT_TOOL}' first" >&2
    exit 1
fi

if [ ! -f "${BEHAT_CONFIG}" ]; then
    echo "Error: ${BEHAT_CONFIG} not found — run '${INIT_TOOL}' first" >&2
    exit 1
fi

# The site's log gets the start and end of every scenario, failed steps
# and all PHP errors as they happen: follow it to watch a long run.
echo "Log: ${BEHAT_LOG}  (follow with: tail -f ${BEHAT_LOG})" >&2

exec php vendor/bin/behat --config "${BEHAT_CONFIG}" "$@"
