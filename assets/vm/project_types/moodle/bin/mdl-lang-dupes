#!/bin/bash
# Tool: find English strings that are translated in more than one way. The
# strings of all given plugins are grouped by their English text, a group is
# listed when its translations differ. Moodle is not needed.
#
# Usage: mdl-lang-dupes [--lang=<code>] [--min=<chars>] <plugin dir>... | --all
#   A plugin dir is a directory, or a path relative to dirroot of the project
#   such as admin/tool/muprog, public/ is found automatically.
#   --lang   check only this language; default is every language in lang/
#   --min    shortest English text to compare, default 25 characters; short
#            labels such as "Archived" often differ on purpose, for example
#            by the gender of the thing they describe
#   --all    every plugin of the project that ships translations
#
# This is a report for review, not a check: the exit code is 0 unless a file
# cannot be loaded.
#
# Examples:
#   mdl-lang-dupes --lang=it --all
#   mdl-lang-dupes --lang=cs --min=1 public/admin/tool/muprog public/admin/tool/mucertify
set -euo pipefail
source /opt/mpd/assets/vm/project_types/moodle/scripts/mpd-env.sh

SCRIPT="/opt/mpd/assets/vm/project_types/moodle/scripts/lang-dupes.php"

LANG_CODE=""
MIN=25
ALL=0
while [ $# -gt 0 ]; do
    case "$1" in
        --lang=*) LANG_CODE="${1#--lang=}"; shift ;;
        --min=*) MIN="${1#--min=}"; shift ;;
        --all) ALL=1; shift ;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
        *) break ;;
    esac
done

if ! [[ "$MIN" =~ ^[0-9]+$ ]] || { [ "$ALL" = 1 ] && [ $# -gt 0 ]; } || { [ "$ALL" = 0 ] && [ $# -lt 1 ]; }; then
    echo "Usage: mdl-lang-dupes [--lang=<code>] [--min=<chars>] <plugin dir>... | --all" >&2
    exit 2
fi

exec php "$SCRIPT" "$LANG_CODE" "$MIN" "$ALL" "$PROJECT_DIR" "$@"
