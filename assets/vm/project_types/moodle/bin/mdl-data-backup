#!/bin/bash
# mdl-data-backup [name] — save this project's database, dataroot and code
# recipe as one .mdb bundle in /srv/backups/. The .mdb format is
# shared with mdl-demo, so a bundle restores into either. Restore with
# mdl-data-restore. See docs/usage.md "Backups".
set -euo pipefail

source /opt/mpd/assets/vm/project_types/moodle/scripts/mpd-env.sh

BUNDLE_NAME="${1:-${PROJECT}-$(date -u +%Y%m%d-%H%M%SZ)}"
# The name becomes "<name>.mdb"; keep it to what the .mdb format accepts.
if ! [[ "$BUNDLE_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    echo "Bad bundle name: '$BUNDLE_NAME' (letters, digits, . _ - only; no leading dot or dash)" >&2
    exit 2
fi

if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured — nothing to back up." >&2
    echo "Run \`mpd start\` first." >&2
    exit 1
fi

DB_ENGINE=$(moodle_status_field '.database.engine')
DB_TAG=$(moodle_status_field '.settings.dbTag')
DBHOST=$(moodle_status_field '.database.host')
if [ -z "$DB_ENGINE" ] || [ -z "$DBHOST" ]; then
    echo "No database recorded for '${PROJECT}' — nothing to back up." >&2
    exit 1
fi
DB_LABEL="${DB_TAG:-$DB_ENGINE}"

DATA_DIR=$(moodle_status_field '.dataDir')
DATAROOT="${DATA_DIR}/dataroot"
if [ ! -d "$DATAROOT" ]; then
    echo "No dataroot at ${DATAROOT} — nothing to back up." >&2
    exit 1
fi

# The tree's live recipe (.mudev.json) makes the bundle rebuildable — mdl-demo
# clones from it on restore. mudev recipe export needs it; reconstruct it from
# the tree when a project was assembled without mudev.
if [ ! -f "${PROJECT_DIR}/.mudev.json" ]; then
    echo "No .mudev.json in ${PROJECT_DIR} — reconstructing it with mudev recipe init"
    if ! ( cd "$PROJECT_DIR" && mudev recipe init ); then
        echo "Could not build a recipe for '${PROJECT}'. Assemble the tree with mudev, then retry." >&2
        exit 1
    fi
fi
RECIPE_ID=$(jq -r '.based_on_recipe // ""' "${PROJECT_DIR}/.mudev.json" 2>/dev/null || echo "")

OUT_DIR="/srv/backups"
OUT_FILE="${OUT_DIR}/${BUNDLE_NAME}.mdb"
if [ -e "$OUT_FILE" ]; then
    echo "Backup '${BUNDLE_NAME}' already exists at ${OUT_FILE}." >&2
    echo "Pick another name, or delete that file first." >&2
    exit 1
fi
mkdir -p "$OUT_DIR"

# The CLI maintenance file 503s web requests before any DB connection. Written
# directly, not via admin/cli/maintenance.php, so the same code works in
# mdl-data-restore, where Moodle cannot start. A pre-existing file is somebody's
# deliberate maintenance mode: leave it, before and after.
MAINT_FILE="${DATAROOT}/climaintenance.html"
MAINT_WAS_ON=0
[ -f "$MAINT_FILE" ] && MAINT_WAS_ON=1

STAGING="$(mktemp -d)"
cleanup() {
    rm -rf "$STAGING"
    if [ "$MAINT_WAS_ON" -eq 0 ]; then
        rm -f "$MAINT_FILE"
    fi
}
trap cleanup EXIT

if [ "$MAINT_WAS_ON" -eq 0 ]; then
    cat >"$MAINT_FILE" <<'HTML'
<!doctype html>
<title>Backup in progress</title>
<p>This site is being backed up and will be back in a moment.</p>
HTML
fi

echo "Backing up '${PROJECT}' to ${OUT_FILE}"

echo "  recipe"
( cd "$PROJECT_DIR" && mudev recipe export --sort --file "${STAGING}/recipe.yaml" )

echo "  database (${DB_LABEL})"
case "$DB_ENGINE" in
    postgres)
        # Dump as the project role. Ownership and grants are not carried
        # (--no-owner --no-privileges): the restore runs as a single role, and a
        # role-free dump loads into any project's — or mdl-demo's "demo" — role.
        # Plain SQL, not gzipped: the .mdb is gzipped as a whole.
        PGPASSWORD="${PROJECT}" pg_dump -h "$DBHOST" -U "${PROJECT}" -d "${PROJECT}" \
            --no-owner --no-privileges -f "${STAGING}/db.sql"
        ;;
    mariadb|mysql)
        client="mariadb-dump"
        [ "$DB_ENGINE" = "mysql" ] && client="mysqldump"
        # --skip-ssl: the client defaults SSL on, but the DB container serves
        # plaintext on the private network, so it would refuse.
        "$client" -h "$DBHOST" -u root -proot --skip-ssl \
            --single-transaction --routines --events --no-tablespaces \
            "${PROJECT}" >"${STAGING}/db.sql"
        ;;
    *)
        echo "Unknown database engine '${DB_ENGINE}' — cannot back up." >&2
        exit 1
        ;;
esac

# meta.json is the FIRST archive member, so a listing reads it without scanning.
# db records the source "<engine>:<version>"; restore gates on it. Passwords are
# never stored — mdl-demo regenerates admin's on restore.
jq -n \
    --arg recipe "$RECIPE_ID" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg db "$DB_LABEL" \
    '{revision:2, recipe:$recipe, created:$created, db:$db,
      users:[{username:"admin", role:"admin"}]}' >"${STAGING}/meta.json"

# The dataroot is added straight from where it lives; climaintenance.html is
# excluded because this tool wrote it. Caches, sessions and trash rebuild on
# demand and are most of the size. Member order: meta.json first.
echo "  dataroot"
tar -czf "$OUT_FILE" \
    --exclude=dataroot/climaintenance.html \
    --exclude=dataroot/cache \
    --exclude=dataroot/localcache \
    --exclude=dataroot/temp \
    --exclude=dataroot/sessions \
    --exclude=dataroot/trashdir \
    --exclude=dataroot/lock \
    -C "$STAGING" meta.json recipe.yaml db.sql \
    -C "$DATA_DIR" dataroot

echo
echo "Saved $(du -h "$OUT_FILE" | cut -f1) to ${OUT_FILE}"
echo "Restore it with: mdl-data-restore ${BUNDLE_NAME}"

# An mdl-demo container ships postgres 17; note when this bundle won't load there.
DB_MAJOR="${DB_LABEL##*:}"
DB_MAJOR="${DB_MAJOR%%.*}"
if [ "$DB_ENGINE" != "postgres" ] || ! [[ "$DB_MAJOR" =~ ^[0-9]+$ ]] || [ "$DB_MAJOR" -gt 17 ]; then
    echo "Note: this bundle is ${DB_LABEL}; an mdl-demo container (postgres 17) cannot restore it."
fi
