#!/bin/bash
# mdl-install — quick Moodle CLI install. Reads defaults from mpd.env.
# All arguments pass through to admin/cli/install_database.php.
set -euo pipefail

source /opt/mpd/assets/vm/project_types/moodle/scripts/mpd-env.sh

# Checks that config.php and a database exist, not that the database
# is empty: install_database.php keys its own already-installed check
# on the real prefix, ignoring phpunit-init's test-prefix tables. A
# table-count guard here would count those and refuse a fresh install.
if ! moodle_configured; then
    echo "Project '${PROJECT}' is not configured yet." >&2
    echo "Run \`mpd start\` first: it makes the database and writes config.php." >&2
    exit 1
fi

# composer.json and vendor/ stay at the project root in every layout.
if [ ! -f "${PROJECT_DIR}/vendor/autoload.php" ]; then
    echo "Running composer install..."
    (cd "${PROJECT_DIR}" && composer install --no-interaction)
fi

EXTRA_OPTS=()
[ -n "${MPD_MOODLE_AGREE_LICENSE:-}" ] && EXTRA_OPTS+=("--agree-license")
[ -n "${MPD_MOODLE_ADMINPASS:-}"     ] && EXTRA_OPTS+=("--adminpass=${MPD_MOODLE_ADMINPASS}")
[ -n "${MPD_MOODLE_ADMINEMAIL:-}"    ] && EXTRA_OPTS+=("--adminemail=${MPD_MOODLE_ADMINEMAIL}")

moodle_run admin/cli/install_database.php \
    --fullname="mpd ${PROJECT}" \
    --shortname="${PROJECT}" \
    --summary="mpd dev site" \
    --adminemail="${MPD_MOODLE_ADMINEMAIL:-admin@example.com}" \
    "${EXTRA_OPTS[@]}" \
    "$@"
