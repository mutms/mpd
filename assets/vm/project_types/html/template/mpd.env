# mpd.env — settings for this static site.
#
# Edit this file to change how this one project runs. Every setting is
# optional. Leave a line out and mpd uses a default.
#
# Two ways to change a setting:
#
#   mpd start <project> MPD_DOCROOT=site
#       Checks the value, writes the line, and applies the change.
#
#   Edit this file by hand, then run: mpd start <project>
#       Accepts any value. The second command is what applies it.
#
# mpd wrote this file when you ran `mpd init` and will never overwrite
# it. Git ignores it.
#
# Where defaults come from and which file wins when two disagree:
# docs/architecture.md, section 8.


# Database
#
# A static site has no database, so this is empty.
#
# Keep it empty. The value is doing work: an empty setting here overrides
# any MPD_DB you set for all your projects in
# /var/lib/mpd/env/mpd-virt.env, which would otherwise give this project a
# database it never uses.
MPD_DB=""


# Which directory to publish
#
# Empty means the project directory itself. Set it to a subdirectory when
# the site is only part of the project - a prototype beside your notes,
# or a build output directory:
#
#   MPD_DOCROOT="flythrough"
#   MPD_DOCROOT="dist"
#
# The path is relative to the project. It cannot start with a slash or
# climb out with "..".
MPD_DOCROOT=""
