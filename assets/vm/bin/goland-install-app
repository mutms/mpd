#!/bin/bash
# goland-install-app — unpack a GoLand archive (made by
# `goland-archive-app`) into the JetBrains Toolbox apps directory.
#
# Read from /opt/mpd/assets, never copied into the home: a 1 GB tarball
# has no business being duplicated. ~/install/ is the local fallback.
# Idempotent and safe to call blindly during provisioning: exits 0 when
# GoLand is already installed or there is no archive.
set -euo pipefail

APPS_DIR="$HOME/.local/share/JetBrains/Toolbox/apps"
APP_NAME="goland"
TARGET="${APPS_DIR}/${APP_NAME}"
OVERLAY_ARCHIVE="/opt/mpd/assets/jetbrains/${APP_NAME}.tgz"
LOCAL_ARCHIVE="$HOME/install/${APP_NAME}.tgz"
ARCHIVE=""
for candidate in "${OVERLAY_ARCHIVE}" "${LOCAL_ARCHIVE}"; do
    if [ -f "${candidate}" ]; then
        ARCHIVE="${candidate}"
        break
    fi
done

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: goland-install-app

Unpack goland.tgz into ~/.local/share/JetBrains/Toolbox/apps/. Reads
/opt/mpd/assets/jetbrains/goland.tgz, or ~/install/goland.tgz. No-op if
GoLand is already installed or neither archive is there.
Make the archive with `goland-archive-app`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

if [ -x "${TARGET}/bin/${APP_NAME}" ]; then
    echo "GoLand already installed at ${TARGET}"
    exit 0
fi

if [ -z "${ARCHIVE}" ]; then
    cat <<EOF
No archive to unpack. Looked in:

    ${OVERLAY_ARCHIVE}
    ${LOCAL_ARCHIVE}

Make one on a VM that has GoLand:

    goland-archive-app

then copy it on your workstation to
~/.mpd-virt/assets/jetbrains/goland.tgz. mpd-virt pushes that to every VM
it adopts or creates.
EOF
    exit 0
fi

# A directory without bin/goland is a failed earlier unpack; clear it.
if [ -e "${TARGET}" ]; then
    echo "Removing incomplete ${TARGET}"
    rm -rf "${TARGET}"
fi

mkdir -p "${APPS_DIR}"

echo "Unpacking ${ARCHIVE}"
STAGE="$(mktemp -d "${APPS_DIR}/.${APP_NAME}.XXXXXX")"
trap 'rm -rf "${STAGE}"' EXIT

# Unpack beside the target and move into place, so an interrupted run
# leaves no half-extracted app.
tar -xzf "${ARCHIVE}" -C "${STAGE}"
[ -x "${STAGE}/${APP_NAME}/bin/${APP_NAME}" ] || die "${ARCHIVE} has no ${APP_NAME}/bin/${APP_NAME} — re-make it with goland-archive-app."

mv "${STAGE}/${APP_NAME}" "${TARGET}"
rm -rf "${STAGE}"
trap - EXIT

BUILD="unknown build"
if [ -f "${TARGET}/build.txt" ]; then
    BUILD="$(cat "${TARGET}/build.txt")"
fi

echo
echo "GoLand installed at ${TARGET} (${BUILD})"
