#!/bin/bash
# gnome-install — add a minimal GNOME desktop, Chromium and browser-automation
# media tools (ffmpeg, emoji font) to a VM that has none. Idempotent.
#
# --no-install-recommends keeps NetworkManager out: the VM runs
# systemd-networkd, so GNOME's network panel stays empty by design.
# Nothing is started and the boot target is left as found; use
# `gnome-start` / `gnome-stop`.
set -euo pipefail

step() { printf '\n==> %s\n' "$*"; }
ok()   { printf '    ok: %s\n' "$*"; }
warn() { printf '    warn: %s\n' "$*"; }
die()  { printf 'Error: %s\n' "$*" >&2; exit 1; }
# Waits for the dpkg lock (packagekitd holds it after login); retries
# stalled downloads.
apt_get() {
    sudo env DEBIAN_FRONTEND=noninteractive \
        apt-get -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 "$@"
}

usage() {
    cat <<'EOF'
Usage: gnome-install [--yes]

Install a minimal GNOME desktop, Chromium and browser-automation media tools
(ffmpeg, emoji font) in this VM.

  --yes, -y   do not ask before downloading

Afterwards: `gnome-start` to boot into the desktop, `gnome-stop` to go
back to headless, `rdp-start` to reach the desktop from a tablet.
EOF
}

# Point Chromium at this VM's portal, https://<NNN>.mpd.test/.
# policies/recommended/ leaves the setting editable; managed/ would lock it.
# The VM id comes from the hostname (mpd-<NNN>), the same identity
# net.Current reads.
install_chromium_homepage() {
    local host nnn url dir
    host="$(hostname -s)"
    nnn="${host#mpd-}"

    step "Chromium home page"
    if [ "${nnn}" = "${host}" ] || [ -z "${nnn}" ] || [ -n "${nnn//[0-9]/}" ]; then
        warn "hostname ${host} is not mpd-<NNN> — skipping the home page"
        return 0
    fi

    url="https://${nnn}.mpd.test/"
    dir=/etc/chromium/policies/recommended
    sudo install -d -m 755 "${dir}"
    sudo tee "${dir}/mpd-homepage.json" >/dev/null <<EOF
{
  "HomepageLocation": "${url}",
  "HomepageIsNewTabPage": false,
  "ShowHomeButton": true,
  "RestoreOnStartup": 4,
  "RestoreOnStartupURLs": ["${url}"]
}
EOF
    sudo chmod 644 "${dir}/mpd-homepage.json"
    ok "${url} — home button and startup page (editable in Chromium)"
}

ASSUME_YES=0
case "${1:-}" in
    -y | --yes) ASSUME_YES=1 ;;
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (accepts --yes)" ;;
esac

# GNOME needs a /dev/dri card device. Debian's cloud kernel ships no DRM
# drivers, so the desktop installs and then shows a black console; warn
# before the download. Test for a card device, not the directory:
# /dev/dri can hold only by-path/ when no driver has bound.
DRM_DEVS=""
for _dev in /dev/dri/card*; do
    [ -e "${_dev}" ] || continue
    DRM_DEVS="${DRM_DEVS}${DRM_DEVS:+ }$(basename "${_dev}")"
done

step "Graphics device"
if [ -n "${DRM_DEVS}" ]; then
    HAS_DRM=1
    ok "DRM device present (${DRM_DEVS})"
else
    HAS_DRM=0
    warn "no /dev/dri — this kernel has no graphics driver"
    case "$(uname -r)" in
        *-cloud-*)
            warn "running the cloud kernel ($(uname -r)), which ships none by design"
            warn "fix: sudo apt-get install linux-image-amd64, then reboot"
            ;;
        *)
            warn "no DRM driver bound to this VM's display adapter"
            ;;
    esac
    warn "the desktop will install, but the VM console stays black until this is fixed"
    warn "'rdp-start' is unaffected — xorgxrdp's X server needs no graphics device"
fi

# gnome-session-xsession is only a Recommends of gnome-session but must
# be named: xrdp (`rdp-start`) needs the X11 session. xdg-utils supplies
# xdg-open for the mpd desktop launcher.
GNOME_PKGS=(
    gnome-session gnome-session-xsession gdm3
    gnome-terminal gnome-control-center
    chromium xdg-utils
    # Media tooling shared by projects that automate the browser (the agent
    # "browser" treat, docs-site screenshots): ffmpeg turns captured frames
    # into GIF/WebP/MP4, and the emoji font makes headless renders match a
    # real desktop.
    ffmpeg fonts-noto-color-emoji
)

step "Desktop packages"

missing=()
for pkg in "${GNOME_PKGS[@]}"; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done

if [ ${#missing[@]} -eq 0 ]; then
    ok "all ${#GNOME_PKGS[@]} packages already installed"
    install_chromium_homepage
    echo
    echo "Run 'gnome-start' to switch this VM into the desktop."
    exit 0
fi

ok "to install: ${missing[*]}"

if [ "${ASSUME_YES}" = 0 ]; then
    # --print-uris prints "'<uri>' <file> <bytes> <hash>" per package.
    dl_mb="$(apt-get install --print-uris -qq --no-install-recommends "${missing[@]}" 2>/dev/null \
        | awk '{s+=$3} END {if (s > 0) printf "%.0f", s/1048576}')"
    if [ -n "${dl_mb}" ]; then
        printf '\nThis pulls in the full GNOME dependency chain — about %s MB to download.\n' "${dl_mb}"
    else
        printf '\nThis pulls in the full GNOME dependency chain — several hundred MB.\n'
    fi
    [ -t 0 ] || die "Not a terminal — re-run interactively, or pass --yes."
    read -r -p "Continue? [y/N] " reply
    case "${reply}" in
        y | Y | yes | YES) ;;
        *) die "Cancelled." ;;
    esac
fi

# Installing gdm3 flips the default target to graphical. Remember the
# current target and restore it after the install.
prev_target="$(systemctl get-default)"
gdm_was_active=0
systemctl is-active --quiet gdm3 2>/dev/null && gdm_was_active=1

apt_get update -qq
apt_get install -y --no-install-recommends "${missing[@]}"
ok "installed ${#missing[@]} package(s)"

step "Boot target"
now_target="$(systemctl get-default)"
if [ "${now_target}" != "${prev_target}" ]; then
    sudo systemctl set-default "${prev_target}" >/dev/null
    ok "restored default target to ${prev_target} (gdm3 install had set ${now_target})"
else
    ok "unchanged: ${prev_target}"
fi

# Debian starts gdm3 on install; stop it again if the VM was headless before.
if [ "${gdm_was_active}" = 0 ] && systemctl is-active --quiet gdm3 2>/dev/null; then
    sudo systemctl stop gdm3
    ok "stopped gdm3 (this VM was headless before)"
fi

install_chromium_homepage

cat <<EOF

================================================================
  GNOME installed
================================================================

Nothing is running yet. From here:

    gnome-start     boot into the desktop now, and at every reboot
    gnome-stop      back to headless
    rdp-start       reach the desktop over RDP (tablet, thin client)

Chromium already trusts this VM's mpd CA — 'mpd --vm-setup' imports it
into ~/.pki/nssdb, which is the store Chromium reads. If a project URL
still warns, re-run 'mpd --vm-setup' and restart Chromium.
EOF

if [ "${HAS_DRM}" = 0 ]; then
    cat <<EOF
WARNING — this VM has no graphics device (no /dev/dri), so 'gnome-start'
will leave the console black. The text console still works, and so does
'rdp-start'. To fix the console:

    sudo apt-get install linux-image-amd64
    sudo reboot

Then check with 'uname -r' that you booted a kernel without '-cloud' in
its name.
EOF
fi
