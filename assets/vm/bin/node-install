#!/bin/bash
# node-install — install nvm + Node.js into $HOME/.nvm.
# Idempotent: no-op if nvm is already installed.
# Default version is "lts"; pass an explicit version to override.
set -euo pipefail

if [ -s "$HOME/.nvm/nvm.sh" ]; then
    echo "nvm already installed at \$HOME/.nvm — open a new shell to use node/nvm."
    exit 0
fi

NODE_VER="${1:-lts}"
export NVM_DIR="$HOME/.nvm"

NVM_VERSION=$(curl -fsSL "https://api.github.com/repos/nvm-sh/nvm/releases/latest" \
    | grep '"tag_name"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')
curl -o- "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash

. "${NVM_DIR}/nvm.sh"

if [ "$NODE_VER" = "lts" ]; then
    nvm install --lts
else
    nvm install "$NODE_VER"
fi
