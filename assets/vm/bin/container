#!/bin/sh
# container — Apple `container` look-alike backed by rootful podman, so
# macOS scripts (mdl-demo's launcher) run on the VM unchanged.
# Covers only the everyday verbs, which podman shares verb-for-verb.
# `ls` prints the name first, as Apple container does, so column filters agree.
# Image- and system-level subcommands are not translated; use podman directly.
verb="$1"; shift
case "$verb" in
    ls) exec sudo podman ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' "$@" ;;
    *)  exec sudo podman "$verb" "$@" ;;
esac
