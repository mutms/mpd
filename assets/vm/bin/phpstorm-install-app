#!/bin/bash
# phpstorm-install-app — unpack a PhpStorm backend archive into the
# JetBrains Toolbox apps directory.
#
# Read straight from the read-only /opt/mpd mount, never copied into the
# home, ~/install/ is the fallback, for an archive made on this box.
# Idempotent: exits 0 when PhpStorm is installed or no archive exists.
set -euo pipefail

APPS_DIR="$HOME/.local/share/JetBrains/Toolbox/apps"
APP_NAME="phpstorm"
TARGET="${APPS_DIR}/${APP_NAME}"
OVERLAY_ARCHIVE="/opt/mpd/assets/installers/${APP_NAME}.tgz"
LOCAL_ARCHIVE="$HOME/install/${APP_NAME}.tgz"
ARCHIVE=""
for candidate in "${OVERLAY_ARCHIVE}" "${LOCAL_ARCHIVE}"; do
    if [ -f "${candidate}" ]; then
        ARCHIVE="${candidate}"
        break
    fi
done

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: phpstorm-install-app

Unpack phpstorm.tgz into ~/.local/share/JetBrains/Toolbox/apps/. Reads
/opt/mpd/assets/installers/phpstorm.tgz, or ~/install/phpstorm.tgz.
No-op if PhpStorm is already installed or neither archive is there.
Make the archive with `phpstorm-archive-app`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

if [ -x "${TARGET}/bin/remote-dev-server.sh" ]; then
    echo "PhpStorm already installed at ${TARGET}"
    exit 0
fi

if [ -z "${ARCHIVE}" ]; then
    cat <<EOF
No archive to unpack. Looked in:

    ${OVERLAY_ARCHIVE}
    ${LOCAL_ARCHIVE}

Make one in a VM that has PhpStorm:

    phpstorm-archive-app

then copy it on your workstation to
~/.mpd-virt/installers/<arch>/phpstorm.tgz. mpd-virt pushes the matching
VM, and every VM reads it from there.
EOF
    exit 0
fi

# A directory without the backend launcher is a failed earlier unpack.
if [ -e "${TARGET}" ]; then
    echo "Removing incomplete ${TARGET}"
    rm -rf "${TARGET}"
fi

mkdir -p "${APPS_DIR}"

echo "Unpacking ${ARCHIVE}"
STAGE="$(mktemp -d "${APPS_DIR}/.${APP_NAME}.XXXXXX")"
trap 'rm -rf "${STAGE}"' EXIT

# Unpack beside the target and move into place, so an interrupted run
# leaves no half-extracted backend.
tar -xzf "${ARCHIVE}" -C "${STAGE}"
[ -x "${STAGE}/${APP_NAME}/bin/remote-dev-server.sh" ] || die "${ARCHIVE} has no ${APP_NAME}/bin/remote-dev-server.sh — re-make it with phpstorm-archive-app."

mv "${STAGE}/${APP_NAME}" "${TARGET}"
rm -rf "${STAGE}"
trap - EXIT

BUILD="unknown build"
if [ -f "${TARGET}/build.txt" ]; then
    BUILD="$(cat "${TARGET}/build.txt")"
fi

echo
echo "PhpStorm installed at ${TARGET} (${BUILD})"
