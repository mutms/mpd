#!/bin/bash
# goland-archive-app — pack this VM's Toolbox-installed GoLand into
# ~/install/goland.tgz. Copy the file into your host-side overlay
# (~/.mpd-virt/assets/jetbrains/) and every VM reads it from
# /opt/mpd/assets/jetbrains/, where `goland-install-app` unpacks it.
# Re-runs replace the archive.
set -euo pipefail

APPS_DIR="$HOME/.local/share/JetBrains/Toolbox/apps"
APP_NAME="goland"
SRC="${APPS_DIR}/${APP_NAME}"
DEST_DIR="$HOME/install"
DEST="${DEST_DIR}/${APP_NAME}.tgz"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: goland-archive-app

Pack ~/.local/share/JetBrains/Toolbox/apps/goland into ~/install/goland.tgz.
Unpack it on another VM with `goland-install-app`.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (takes none)" ;;
esac

[ -d "${SRC}" ] || die "No GoLand install at ${SRC} — install it through JetBrains Toolbox first."
[ -x "${SRC}/bin/${APP_NAME}" ] || die "${SRC} has no bin/${APP_NAME} — the install looks incomplete."

BUILD="unknown build"
if [ -f "${SRC}/build.txt" ]; then
    BUILD="$(cat "${SRC}/build.txt")"
fi

mkdir -p "${DEST_DIR}"

# Write to a temp file and rename, so an interrupted run leaves no
# half-written archive for `goland-install-app` to unpack.
TMP="$(mktemp "${DEST}.XXXXXX")"
trap 'rm -f "${TMP}"' EXIT

echo "Archiving ${SRC} (${BUILD})"
echo "This takes a few minutes — gzip over a couple of gigabytes."

# -C keeps a single top-level `goland/`. Toolbox may touch files during
# the tar; suppress only that warning so tar does not exit 1.
tar --warning=no-file-changed -czf "${TMP}" -C "${APPS_DIR}" "${APP_NAME}"

mv -f "${TMP}" "${DEST}"
trap - EXIT
chmod 644 "${DEST}"

echo
echo "Wrote ${DEST} ($(du -h "${DEST}" | cut -f1), ${BUILD})"

# The host-side ssh alias is the hostname.
# SC2088: the tilde stays literal — the string is printed for the
# developer's workstation, not expanded here.
# shellcheck disable=SC2088
OVERLAY="~/.mpd-virt/assets/jetbrains"
cat <<EOF

To seed it into every future VM, run this on your workstation:

    mkdir -p ${OVERLAY}
    scp $(hostname):${DEST/#"${HOME}"/\~} ${OVERLAY}/

mpd-virt pushes that overlay on adopt and create; new VMs then run

    goland-install-app
EOF
