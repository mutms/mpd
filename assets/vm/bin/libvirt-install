#!/bin/bash
# libvirt-install — turn this VM into a libvirt/KVM host for mpd-virt testing.
#
# An mpd VM is the place mpd gets developed and tested, and mpd-virt's
# libvirt backend lets it also be the place mpd-virt makes *further* VMs
# (`mpd-virt create NNN --backend=libvirt`). That needs a hypervisor
# inside the VM, which is nested virtualisation: the outer hypervisor
# must hand the CPU's VMX/SVM extensions through (Proxmox: CPU type
# `host`; Parallels/UTM/Fusion: the "nested virtualisation" checkbox).
# This script checks for that first, since nothing below is any use
# without it, then does the one-time host prep from mpd-virt's
# docs/LIBVIRT.md and fetches the two host-side repos:
#
#   1. qemu/KVM + libvirt installed; libvirtd enabled; this user in the
#      `libvirt` group; the `default` NAT network up and autostarted;
#      /var/lib/mpd-virt/ for the nested VMs' disks (outside $HOME, which
#      is 0700 and so unreadable to qemu's libvirt-qemu user).
#   2. KVM's own `nested=1` pinned in /etc/modprobe.d, so the VMs made
#      here (they run with <cpu mode='host-passthrough'>) see VMX/SVM in
#      turn and can nest one level deeper themselves.
#   3. https://github.com/mutms/mpd-virt cloned to ~/Developer/mpd-virt
#      and `make install`ed — the binary lands in ~/.local/bin/mpd-virt,
#      which is already on PATH on an mpd VM.
#   4. https://github.com/mutms/mpd-proxy cloned to ~/Developer/mpd-proxy
#      and left unbuilt: it is the macOS overlay helper and is not
#      Linux-ready yet. The clone is there to work on, not to run.
#
# Idempotent: a second run installs nothing, re-clones nothing (an
# existing clean clone is fast-forwarded, a dirty one is left alone) and
# rebuilds mpd-virt from whatever the checkout holds.
set -euo pipefail

step() { printf '\n==> %s\n' "$*"; }
ok() { printf '    ok: %s\n' "$*"; }
warn() { printf '    warn: %s\n' "$*"; }
die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}
# apt-get waits for the dpkg lock (GNOME's packagekitd holds it after
# login) and retries stalled downloads.
apt_get() {
    sudo env DEBIAN_FRONTEND=noninteractive \
        apt-get -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 "$@"
}

usage() {
    cat <<'EOF'
Usage: libvirt-install [--yes]

Make this VM a libvirt/KVM host for mpd-virt's libvirt backend, and
fetch mpd-virt (built) and mpd-proxy (source only) into ~/Developer/.

  --yes, -y   do not ask before installing packages

Needs nested virtualisation enabled on the outer hypervisor — the
script refuses to continue without VMX/SVM and /dev/kvm.

Afterwards: `mpd-virt create 150 --backend=libvirt` makes a nested mpd VM
at 192.168.122.150 (log in again first if the script added you to the
`libvirt` group).
EOF
}

ASSUME_YES=0
case "${1:-}" in
    -y | --yes) ASSUME_YES=1 ;;
    -h | --help)
        usage
        exit 0
        ;;
    "") ;;
    *) die "Unknown argument: $1 (accepts --yes)" ;;
esac

DEV_DIR="${HOME}/Developer"
MPD_VIRT_REPO=https://github.com/mutms/mpd-virt.git
MPD_VIRT_DIR="${DEV_DIR}/mpd-virt"
MPD_PROXY_REPO=https://github.com/mutms/mpd-proxy.git
MPD_PROXY_DIR="${DEV_DIR}/mpd-proxy"

# --- Nested virtualisation ----------------------------------------------
# Two things have to be true before KVM can run here: the CPU the outer
# hypervisor shows us advertises VMX (Intel) or SVM (AMD), and the kernel
# has bound /dev/kvm to it. The first is the outer hypervisor's setting;
# the second follows from it on a stock Debian kernel (kvm_intel/kvm_amd
# autoload), so a missing /dev/kvm with VMX present is the odd case and
# gets its own hint.
step "Nested virtualisation"
if grep -qE '^flags\s*:.*\b(vmx|svm)\b' /proc/cpuinfo; then
    ok "CPU advertises $(grep -qw vmx /proc/cpuinfo && echo VMX || echo SVM)"
else
    warn "this VM's CPU shows neither VMX nor SVM — the outer hypervisor is not passing virtualisation through"
    warn "Proxmox: set the VM's CPU type to 'host' (Hardware / Processors)"
    warn "Parallels / UTM / Fusion: enable 'nested virtualisation' in the VM's settings"
    die "nested virtualisation is required; fix the outer VM's settings and reboot it"
fi
if [ -c /dev/kvm ]; then
    ok "/dev/kvm present"
else
    warn "/dev/kvm is missing although the CPU has the extensions"
    warn "try: sudo modprobe $(grep -qw vmx /proc/cpuinfo && echo kvm_intel || echo kvm_amd)"
    die "no /dev/kvm — KVM cannot start guests here"
fi

# --- Package set --------------------------------------------------------
# The list from mpd-virt's docs/LIBVIRT.md plus what the build needs.
# git/make are on every mpd VM already (bootstrap step 20) and are named
# only so the script also works on a plainer Debian.
#
#   qemu-system-x86        the hypervisor binary (qemu-system-x86_64)
#   libvirt-daemon-system  libvirtd + its default network definition
#   libvirt-clients        virsh, which the backend drives everything with
#   qemu-utils             qemu-img, to make the VM's disk from the cloud image
#   genisoimage            the cloud-init NoCloud seed ISO
#   git make               fetch and build mpd-virt (Go itself comes from
#                          mpd's bootstrap step 30, already on every mpd VM)
PKGS=(
    qemu-system-x86 libvirt-daemon-system libvirt-clients qemu-utils genisoimage
    git make
)

step "Packages"
missing=()
for pkg in "${PKGS[@]}"; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if [ ${#missing[@]} -eq 0 ]; then
    ok "all ${#PKGS[@]} packages already installed"
else
    ok "to install: ${missing[*]}"
    if [ "${ASSUME_YES}" = 0 ]; then
        dl_mb="$(apt-get install --print-uris -qq --no-install-recommends "${missing[@]}" 2>/dev/null \
            | awk '{s+=$3} END {if (s > 0) printf "%.0f", s/1048576}')"
        printf '\nqemu + libvirt — about %s MB to download.\n' "${dl_mb:-?}"
        [ -t 0 ] || die "Not a terminal — re-run interactively, or pass --yes."
        read -r -p "Continue? [y/N] " reply
        case "${reply}" in
            y | Y | yes | YES) ;;
            *) die "Cancelled." ;;
        esac
    fi
    apt_get update -qq
    apt_get install -y --no-install-recommends "${missing[@]}"
    ok "installed ${#missing[@]} package(s)"
fi

# --- KVM nested=1 for the guests ------------------------------------------
# The guests mpd-virt makes here run with <cpu mode='host-passthrough'>,
# so they see VMX/SVM only if *this* kernel's KVM exposes it, which is the
# module's `nested` parameter. Debian's kernel defaults it on, but the
# default has changed before; pin it so the guests can nest a level deeper
# no matter what. Takes effect at the next module load — the live value is
# reported either way, and a reload is attempted only while no guest runs.
step "KVM nested parameter"
if grep -qw vmx /proc/cpuinfo; then kvm_mod=kvm_intel; else kvm_mod=kvm_amd; fi
conf=/etc/modprobe.d/kvm-nested.conf
want="options kvm_intel nested=1
options kvm_amd nested=1"
if [ -f "${conf}" ] && [ "$(cat "${conf}")" = "${want}" ]; then
    ok "${conf} already pins nested=1"
else
    printf '%s\n' "${want}" | sudo tee "${conf}" >/dev/null
    sudo chmod 644 "${conf}"
    ok "wrote ${conf}"
fi
nested_live="$(cat "/sys/module/${kvm_mod}/parameters/nested" 2>/dev/null || echo "?")"
case "${nested_live}" in
    Y | 1) ok "${kvm_mod} nested=${nested_live} (live)" ;;
    *)
        if sudo modprobe -r "${kvm_mod}" 2>/dev/null && sudo modprobe "${kvm_mod}"; then
            ok "reloaded ${kvm_mod} with nested=1"
        else
            warn "${kvm_mod} is loaded with nested=${nested_live} and is busy — guests made before a reboot cannot nest"
        fi
        ;;
esac

# --- libvirtd ---------------------------------------------------------------
step "libvirtd"
if systemctl is-active --quiet libvirtd; then
    ok "libvirtd running"
else
    sudo systemctl enable --now libvirtd >/dev/null
    ok "libvirtd enabled and started"
fi

# The backend talks to qemu:///system as the plain user; the `libvirt`
# group is what libvirt's polkit rule grants that to. A group change only
# lands on the next login, so say so instead of pretending.
step "libvirt group"
RELOGIN=0
if id -nG "$USER" | tr ' ' '\n' | grep -qx libvirt; then
    ok "$USER is in libvirt"
else
    sudo adduser "$USER" libvirt >/dev/null
    RELOGIN=1
    ok "added $USER to libvirt — takes effect at the next login"
fi

# --- default NAT network ----------------------------------------------------
# libvirt ships it defined but inactive. mpd-virt pins its VMs to
# 192.168.122.NNN on this network's bridge (virbr0), so it has to be up
# and come back up on its own after a reboot.
step "default network"
net_info="$(sudo virsh -q net-info default 2>/dev/null)" \
    || die "libvirt has no 'default' network — libvirt-daemon-system normally defines it; check 'sudo virsh net-list --all'"
if grep -q '^Active: *yes' <<<"${net_info}"; then
    ok "active"
else
    sudo virsh -q net-start default >/dev/null
    ok "started"
fi
if grep -q '^Autostart: *yes' <<<"${net_info}"; then
    ok "autostart on"
else
    sudo virsh -q net-autostart default >/dev/null
    ok "autostart enabled"
fi

# --- /var/lib/mpd-virt -------------------------------------------------------
step "/var/lib/mpd-virt"
if [ -d /var/lib/mpd-virt ] && [ "$(stat -c %U /var/lib/mpd-virt)" = "$USER" ]; then
    ok "present, owned by $USER"
else
    sudo install -d -o "$USER" -g "$USER" -m 0755 /var/lib/mpd-virt
    ok "created, owned by $USER"
fi

# --- Repos ------------------------------------------------------------------
# clone_or_update <url> <dir>: a fresh clone, or a fast-forward of an
# existing one — and a dirty checkout is left exactly as it is, since
# this is where the developer works and nothing here may cost them an
# edit. A non-git directory of the same name is an error, not a merge.
clone_or_update() {
    local url="$1" dir="$2"
    if [ ! -e "${dir}" ]; then
        git clone --quiet "${url}" "${dir}"
        ok "cloned ${url} → ${dir}"
        return 0
    fi
    [ -d "${dir}/.git" ] || die "${dir} exists but is not a git checkout — move it aside and re-run"
    if [ -n "$(git -C "${dir}" status --porcelain)" ]; then
        warn "${dir} has local changes — left alone, not pulled"
        return 0
    fi
    if git -C "${dir}" pull --quiet --ff-only 2>/dev/null; then
        ok "${dir} up to date ($(git -C "${dir}" rev-parse --short HEAD))"
    else
        warn "${dir}: could not fast-forward (offline, or the branch diverged) — left as is"
    fi
}

step "mpd-virt"
mkdir -p "${DEV_DIR}"
clone_or_update "${MPD_VIRT_REPO}" "${MPD_VIRT_DIR}"
# `make install` = build + copy to ~/.local/bin, which mpd's bootstrap put
# on PATH. GOTOOLCHAIN=local is set by the Makefile: a go.mod newer than
# Debian's Go fails here legibly instead of downloading a toolchain.
make -C "${MPD_VIRT_DIR}" --no-print-directory install >/dev/null
ok "built and installed $("${HOME}/.local/bin/mpd-virt" --version 2>/dev/null || echo "${HOME}/.local/bin/mpd-virt")"

step "mpd-proxy"
clone_or_update "${MPD_PROXY_REPO}" "${MPD_PROXY_DIR}"
ok "source only — not built (not Linux-ready yet)"

# --- Done -------------------------------------------------------------------
echo
if [ "${RELOGIN}" = 1 ]; then
    echo "Log out and back in (new libvirt group membership), then:"
else
    echo "Ready. Make a nested mpd VM with:"
fi
echo "  mpd-virt create 150 --backend=libvirt"
echo "It comes up at 192.168.122.150; 'ssh mpd-150' reaches it from here."
