#!/bin/bash
set -euo pipefail
# Tool: install one PHP version on demand.
#
#   php-install 7.4
#
# --vm-setup installs the MPD_PHP_VERSIONS set (lib/php-configure.sh);
# anything outside it, such as an EOL 7.4, arrives here. `mpd start`
# calls this when a project's MPD_PHP_VERSION is missing.
# Idempotent: an already-installed version exits 0 without touching apt.
# Installs the same extension set, php.ini defaults and FPM wiring as
# the default set.

VER="${1:-}"
if [ -z "$VER" ]; then
    echo "Usage: php-install <version>   (e.g. php-install 7.4)" >&2
    exit 2
fi
# The value reaches apt as php<VER>-*; allow only <major>.<minor>.
if ! [[ "$VER" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo "Bad PHP version '${VER}' — expected <major>.<minor>, e.g. 7.4 or 8.0." >&2
    exit 2
fi

if [ -x "/usr/bin/php${VER}" ]; then
    exit 0
fi

# The Sury repo is normally added at runtime build; add it for a runtime
# built before this tool existed.
SURY_LIST="/etc/apt/sources.list.d/sury-php.list"
if [ ! -f "$SURY_LIST" ]; then
    echo "Adding the Sury PHP repository..."
    sudo apt-get install -y --no-install-recommends apt-transport-https ca-certificates curl gnupg2 lsb-release
    curl -fsSL https://packages.sury.org/php/apt.gpg \
        | sudo gpg --dearmor -o /usr/share/keyrings/sury-php.gpg
    echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
        | sudo tee "$SURY_LIST" >/dev/null
    sudo apt-get update -qq
fi

# shellcheck source=/dev/null
. /opt/mpd/assets/vm/lib/php-configure.sh

PKG_LIST=$(mpd_php_package_list "$VER")
if ! printf '%s' "$PKG_LIST" | grep -q "php${VER}-cli"; then
    echo "PHP ${VER} is not available in the apt index (php${VER}-cli missing)." >&2
    echo "Check the version, or run: sudo apt-get update" >&2
    exit 1
fi

echo "Installing PHP ${VER} (${PKG_LIST})..."
export DEBIAN_FRONTEND=noninteractive
# shellcheck disable=SC2086
sudo apt-get install -y --no-install-recommends $PKG_LIST

mpd_php_configure_version "$VER"

echo "PHP ${VER} installed."
