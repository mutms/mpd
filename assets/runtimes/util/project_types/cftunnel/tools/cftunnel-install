#!/bin/bash
# Tool: install Cloudflare's `cloudflared` daemon via Cloudflare's
# official apt repository.
#
# Idempotent: no-op if the binary is already installed (per
# ARCHITECTURE.md §7). To force a refresh, remove the binary first
# (e.g. `sudo apt-get purge cloudflared`) and re-run.
#
# Runs as the dev user; uses `sudo` only for the privileged steps
# (apt key install, sources file write, apt operations). The dev/AI
# invokes this as a bare `cftunnel-install`, never `sudo cftunnel-install`.
#
# CF's apt repo is the project's recommended install method:
#   https://pkg.cloudflare.com/index.html#debian
# It gives us GPG-verified packages and `apt upgrade` for free.

set -euo pipefail

readonly KEYRING="/usr/share/keyrings/cloudflare-main.gpg"
readonly SOURCES="/etc/apt/sources.list.d/cloudflared.list"

if command -v cloudflared >/dev/null 2>&1; then
    echo "cloudflared already installed: $(cloudflared --version 2>&1 | head -1)"
    exit 0
fi

echo "Setting up Cloudflare apt repo..."
sudo mkdir -p --mode=0755 /usr/share/keyrings
curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg \
    | sudo tee "$KEYRING" >/dev/null

echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' \
    | sudo tee "$SOURCES" >/dev/null

echo "Installing cloudflared via apt..."
sudo apt-get update -q
sudo apt-get install -y --no-install-recommends cloudflared

echo "Installed: $(cloudflared --version 2>&1 | head -1)"
