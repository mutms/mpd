#!/bin/bash
# Tool: project-aware PHP version dispatcher.
# Resolves PHP version via $MPD_PHP_VERSION (the env var is the source of
# truth — populated by the layered mpd.env: runtime defaults → type
# defaults → user → project). Falls back to the system default outside a
# project tree or if no version is configured.
#
# Lives at /mnt/assets/runtimes/php/tools/php (bind-mounted live).
# Symlinked into /srv/tools/php/php and /usr/local/bin/php at runtime
# provision time so it's reachable both via PATH and via absolute path.
#
# Optimization: when called from a tool chain that already sourced mpd.env
# (e.g. phpunit-init → phpunit), $MPD_PHP_VERSION is already exported and
# this wrapper short-circuits — no extra fork. Only bare CLI invocations
# from an SSH session pay the source-mpd-env.sh cost (~one jq + 4 file
# reads, ~30ms).

if [[ -z "${MPD_PHP_VERSION:-}" ]] && [[ "$PWD" =~ ^/srv/projects/([^/]+) ]]; then
    PROJECT_NAME="${BASH_REMATCH[1]}"
    # shellcheck source=/dev/null
    source /mnt/assets/runtime-base/lib/source-mpd-env.sh
fi

if [[ -n "${MPD_PHP_VERSION:-}" ]] && [[ -x "/usr/bin/php${MPD_PHP_VERSION}" ]]; then
    exec "/usr/bin/php${MPD_PHP_VERSION}" "$@"
fi
exec /usr/bin/php "$@"
