#!/bin/bash
set -euo pipefail
# Tool: install the `mudev` development toolchain into this php runtime.
#
# Lays out four /opt directories, clones the public repos into three of
# them, builds the `mudev` binary, and symlinks it onto PATH:
#
#   /opt/mudev        ← https://github.com/mutms/mudev.git        (built)
#   /opt/mdl-plugins  ← https://github.com/mutms/mdl-plugins.git
#   /opt/mdl-recipes  ← https://github.com/mutms/mdl-recipes.git
#   /opt/dev-recipes  ← created empty, on purpose: private content the
#                       dev drops in by hand, nothing to clone.
#
# SUPERSEDED: this tool is on its way out. Once /srv is mounted on the VM
# and `mpd --vm-setup` provisions mudev + the index repos VM-side, both
# mudev-install and mudev-install-dev are deleted — see
# docs/proposals/vm-srv-mount.md. Left working in the meantime.
#
# Runs as the dev user inside the runtime; sudo only for creating the
# /opt dirs, which are then chowned to the dev user so all git and build
# operations afterwards are unprivileged.
#
# Idempotent, and *converging* rather than no-op: re-running fetches
# nothing it already has, but always rebuilds and re-links, so
# `mudev-install` after a `git pull` is the way to pick up changes.
#
# NOTE ON PERSISTENCE: /opt lives in the container's own filesystem, not
# on the /srv data volume. Runtime containers are pets — upgraded in
# place, never recreated — so this survives restarts. It does not survive
# deleting the runtime. Anything uncommitted in these checkouts is lost
# if the runtime is ever deleted; push your work.
#
# Usage:
#   mudev-install

DEV_USER="$(id -un)"
DEV_GROUP="$(id -gn)"

# Cloned over anonymous HTTPS — these are public repos, so no key, no
# agent forwarding, nothing to set up first.
REPOS=(
    "mudev|https://github.com/mutms/mudev.git"
    "mdl-plugins|https://github.com/mutms/mdl-plugins.git"
    "mdl-recipes|https://github.com/mutms/mdl-recipes.git"
)
# Created but never cloned into — private material, dev-managed.
EMPTY_DIRS=(dev-recipes)

say()  { printf '==> %s\n' "$*"; }
ok()   { printf '    ok: %s\n' "$*"; }
die()  { printf 'mudev-install: %s\n' "$*" >&2; exit 1; }

# --- Preflight: go and make must be available -------------------------------

command -v go   >/dev/null 2>&1 || die "go not found — rebuild the php runtime (assets/runtimes/php/build.sh installs golang-go)."
command -v make >/dev/null 2>&1 || die "make not found — rebuild the php runtime (assets/runtimes/php/build.sh installs make)."

# --- /opt layout ------------------------------------------------------
# sudo for the mkdir under /opt (root-owned), then hand ownership to the
# dev user so nothing after this point needs privileges.
say "Directories under /opt"
for entry in "${REPOS[@]}" "${EMPTY_DIRS[@]}"; do
    name="${entry%%|*}"
    dir="/opt/${name}"
    if [ -d "$dir" ]; then
        ok "${dir} exists"
    else
        sudo install -d -o "$DEV_USER" -g "$DEV_GROUP" -m 0755 "$dir"
        ok "created ${dir}"
    fi
    # Re-assert ownership even when the dir already existed: a directory
    # left root-owned by an earlier manual mkdir would break every git
    # operation below, and silently.
    owner="$(stat -c '%U:%G' "$dir")"
    if [ "$owner" != "${DEV_USER}:${DEV_GROUP}" ]; then
        sudo chown -R "${DEV_USER}:${DEV_GROUP}" "$dir"
        ok "chowned ${dir} (${owner} → ${DEV_USER}:${DEV_GROUP})"
    fi
done

# --- Clones -----------------------------------------------------------
say "Repositories"
for entry in "${REPOS[@]}"; do
    name="${entry%%|*}"
    url="${entry#*|}"
    dir="/opt/${name}"
    if [ -d "${dir}/.git" ]; then
        ok "${name} already cloned"
    elif [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
        die "${dir} is not empty but is not a git checkout — move it aside and re-run."
    else
        git clone "$url" "$dir"
        ok "cloned ${name}"
    fi
done

for name in "${EMPTY_DIRS[@]}"; do
    ok "/opt/${name} left empty (private content — nothing to clone)"
done

# --- Build + link -----------------------------------------------------
say "Building mudev"
make -C /opt/mudev install

# `make install` puts the binary somewhere in the checkout; find it
# rather than assuming, so a Makefile change doesn't silently leave a
# stale symlink behind.
BIN=""
for candidate in /opt/mudev/bin/mudev /opt/mudev/mudev; do
    [ -x "$candidate" ] && { BIN="$candidate"; break; }
done
[ -n "$BIN" ] || die "'make install' finished but no mudev binary found at /opt/mudev/bin/mudev or /opt/mudev/mudev.
    Check the Makefile's install target and adjust this tool's search list."

# ~/.local/bin is pre-created by runtime-base/bootstrap.sh and put on
# PATH by the shipped skel .bashrc — the same slot claude-install uses.
mkdir -p "${HOME}/.local/bin"
ln -sfn "$BIN" "${HOME}/.local/bin/mudev"
ok "linked ${HOME}/.local/bin/mudev → ${BIN}"

printf '\n'
ok "mudev ready: $(mudev --version 2>/dev/null || echo "$BIN")"
echo "    Open a new shell (or 'hash -r') if 'mudev' isn't on PATH yet."
