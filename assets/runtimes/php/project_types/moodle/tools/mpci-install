#!/bin/bash
# Tool: install or update moodle-plugin-ci into /opt/mpd/mpci/.
# Runs as the calling user. Uses sudo only to create the dev-owned
# install dir; composer create-project / update then run unprivileged
# against the dev-owned tree (per ARCHITECTURE.md §7 privilege model).
# The dev/AI invokes as bare `mpci-install`, never `sudo mpci-install`.
set -euo pipefail

TARGET="/opt/mpd/mpci"

# /opt/ is root-owned. Create /opt/mpd/ + /opt/mpd/mpci/ once with
# dev-user ownership; subsequent operations need no privilege.
if [ ! -d "$TARGET" ]; then
    DEV_USER=$(id -un)
    sudo install -d -m 0755 -o "$DEV_USER" -g "$DEV_USER" /opt/mpd
    sudo install -d -m 0755 -o "$DEV_USER" -g "$DEV_USER" "$TARGET"
fi

if [ -d "$TARGET/vendor" ]; then
    echo "Updating moodle-plugin-ci at $TARGET..."
    cd "$TARGET"
    composer update --no-interaction
else
    echo "Installing moodle-plugin-ci into $TARGET..."
    composer create-project --no-interaction moodlehq/moodle-plugin-ci "$TARGET"
fi

echo "Done. Use 'mpci' to run moodle-plugin-ci commands."
