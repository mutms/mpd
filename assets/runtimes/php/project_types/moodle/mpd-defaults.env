# mpd-defaults.env — Moodle project-type defaults.
#
# Sourced by source-mpd-env.sh between the runtime defaults
# (assets/runtimes/php/mpd-defaults.env) and the per-developer
# mpd-user.env. Override per-developer in ~/.mpd/mpd-user.env or
# per-project in /srv/projects/<n>/mpd.env.

# Behat support. Off by default — the Selenium sidecar that Behat
# pulls in is a ~1.5 GB image, slow on first attach, with little
# value if you're not actively writing/running Behat tests. Set to 1
# (per-developer in mpd-user.env or per-project in mpd.env) when you
# need Behat for a session.
MPD_PHP_MOODLE_BEHAT=0
