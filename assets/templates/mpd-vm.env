# mpd-vm.env — VM-wide defaults that span all projects in this VM.
#
# Lives at /var/lib/mpd/env/mpd-vm.env on the host AND inside every
# runtime container (directory bind-mount). Edits are visible immediately
# inside running runtimes — no sync, no reload step.
#
# Layered third (after runtime + type defaults, before per-project mpd.env).
#
# All keys are namespaced MPD_<RUNTIME>_<TYPE>_<KEY> (project-type-specific)
# or MPD_<RUNTIME>_<KEY> (runtime-wide) or MPD_<KEY> (mpd infra).

# === PHP runtime =============================================================

# PHP version applied to all PHP project types (currently: moodle).
# Available: 8.1, 8.2, 8.3, 8.4, 8.5. Runtime default lives in
# /opt/mpd/assets/runtimes/php/mpd-defaults.env; uncomment here to override
# globally for your projects.
#MPD_PHP_VERSION=8.4

# === Moodle install defaults =================================================

# Automatically agree to license during site-install.
#MPD_PHP_MOODLE_AGREE_LICENSE=1

# Default administrator password for site-install.
#MPD_PHP_MOODLE_ADMINPASS=Admin.1234

# Default administrator email for site-install.
#MPD_PHP_MOODLE_ADMINEMAIL=admin@example.com

# === PHPUnit settings ========================================================

# Allow execution of tests that need external services (redis, memcached, solr, ldap).
#MPD_PHP_MOODLE_PHPUNIT_EXTERNAL_SERVICES=1

# === Behat settings ==========================================================

# Use headless browser in Behat tests.
#MPD_PHP_MOODLE_BEHAT_BROWSER_HEADLESS=1

# === Xdebug ==================================================================

# Enable Xdebug: off, debug, profile, coverage, trace
# Requires runtime recreation to take effect.
#MPD_PHP_XDEBUG_MODE=off

# === Cloudflare Tunnel (util runtime) ========================================

# Public domain for cftunnel preview URLs. When set, `<target>-cftunnel`
# projects on the util runtime expose their target via
# `<target><domain>` (e.g. `moodle520.mpd-test.org`). Required by
# `mpd configure <name>-cftunnel` AND by moodle's MPD_PHP_MOODLE_CFTUNNEL
# wwwroot detection.
#
# Leading dot is optional but recommended for readability.
#MPD_UTIL_CFTUNNEL_DOMAIN=.mpd-test.org

# === mpd inside runtime containers ===========================================

# Turn off the ability to run `mpd create|configure|start|stop|delete|show`
# from inside a runtime container. Left on, `mpd` works over that runtime's
# control socket, scoped to projects belonging to that runtime.
#
# The reason to turn it off is blast radius: a runtime is where AI agents run
# with passwordless sudo, and with this on such an agent can delete a project
# (its database, dataroot and source tree), not only edit files. It can never
# reach another runtime's projects, create runtimes or databases, or run any
# --vm-* flag. See docs/SECURITY.md.
#
# Read per request: a change applies to the next command, no restart.
# Only off/false/0/no disable it.
#MPD_RUNTIME_CONTROL=off
