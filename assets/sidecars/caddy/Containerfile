# mpd Caddy frontdoor sidecar.
#
# Reads /srv/meta/*/urls.json on a watch loop, generates a Caddyfile from the
# `backend` blocks declared by each project's configure.sh, and reloads Caddy.
# One instance per runtime pod (Phase 8 of the URL redesign — see
# docs/REDESIGN_PROJECT_URLS.md).

FROM docker.io/caddy:2-alpine

# inotify-tools for the file watcher; jq for parsing urls.json in shell.
# Both are tiny on Alpine.
RUN apk add --no-cache bash inotify-tools jq

COPY templates/ /opt/mpd/templates/
COPY gen-caddyfile.sh /opt/mpd/gen-caddyfile.sh
COPY entry.sh /opt/mpd/entry.sh
RUN chmod +x /opt/mpd/gen-caddyfile.sh /opt/mpd/entry.sh

# Caddy runs as root for port binding (443) and reading
# /srv/meta/<project>/key.pem (mode 0600 root-owned). The actual file-touching
# backends (PHP-FPM, node dev servers) run in sibling pod containers as
# $EXTUSER per Phase 7.5.
ENTRYPOINT ["/opt/mpd/entry.sh"]
