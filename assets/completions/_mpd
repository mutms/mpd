#compdef mpd

# mpd zsh completion shim. Forwards to `mpd --complete` for the
# candidate set — see go/internal/cli/complete.go; new flags and verbs
# need only Go edits.

_mpd() {
    emulate -L zsh
    local -a candidates
    local IFS=$'\n'
    # CURRENT is 1-based; --complete expects 0-based cword.
    candidates=( ${(f)"$(command mpd --complete $((CURRENT - 1)) "${words[@]}" 2>/dev/null)"} )
    if (( ${#candidates} )); then
        compadd -- "${candidates[@]}"
    fi
}

_mpd "$@"
